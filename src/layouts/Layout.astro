---
import { ClientRouter } from 'astro:transitions';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	fullWidth?: boolean;
	minimal?: boolean;
}

const { 
	title = "Yang Photography | 獨立攝影與視覺敘事", 
	description = "Yang Photography - 駐點台灣的獨立攝影師。提供婚禮記錄、登記寫真、個人人像、旅拍隨筆、商品攝影與活動紀錄。捕捉自然光影，紀錄真實而純粹的瞬間。",
	image = "https://yangphoto.vercel.app/images/albums/00_Home/Carousel/DSC06557.webp",
	fullWidth = false, 
	minimal = false 
} = Astro.props;

const pathname = new URL(Astro.url).pathname.replace(/\/$/, '') || '/';
const siteUrl = Astro.site ? Astro.site.origin : 'https://yangphoto.vercel.app';
const canonicalURL = new URL(pathname, siteUrl).href;
const pageMetadata: Record<string, { title: string; description: string }> = {
	'/': {
		title: 'Yang Photography | Taiwan Wedding, Portrait & Commercial Photographer',
		description: 'Yang Photography captures natural light, honest moments, weddings, portraits, events and commercial stories across Taiwan.',
	},
	'/wedding': { title: '婚禮紀錄｜Yang Photography', description: '以自然、細膩的視角記錄婚禮儀式、宴會與每一個重要瞬間。' },
	'/registration': { title: '登記寫真｜Yang Photography', description: '記錄結婚登記這天的儀式感、合影與最親近的人。' },
	'/portrait': { title: '個人與情侶寫真｜Yang Photography', description: '自然不過度擺拍的人像與情侶寫真，留下舒服而真實的片刻。' },
	'/travel': { title: '旅拍隨筆｜Yang Photography', description: '用自然光與真實互動記錄旅行中的人與風景。' },
	'/product': { title: '商品與商業攝影｜Yang Photography', description: '為商品、品牌與專案打造清楚、有質感且可被使用的視覺素材。' },
	'/event': { title: '活動紀錄｜Yang Photography', description: '記錄活動現場、品牌聚會與講座的真實節奏與氛圍。' },
	'/service': { title: '攝影服務與方案｜Yang Photography', description: '瀏覽婚禮、人像、情侶、登記、活動與商業攝影方案，開始預約詢問。' },
	'/booking': { title: '預約攝影服務｜Yang Photography', description: '選擇拍攝方案與方便時段，送出 Yang Photography 的預約詢問。' },
	'/about': { title: '關於 Yang｜Yang Photography', description: '認識以自然光與真實互動記錄故事的攝影師 Yang。' },
	'/links': { title: 'Yang Photography | Links', description: 'Yang Photography 的作品、服務方案、預約與 Instagram 連結。' },
};
Object.assign(pageMetadata, {
	'/wedding': { title: 'Taiwan Wedding Photography | Yang Photography', description: 'Natural, thoughtful wedding photography for ceremonies, receptions and the moments in between.' },
	'/registration': { title: 'Registration Photography | Yang Photography', description: 'Thoughtful photography for your registration day, family portraits and intimate celebrations.' },
	'/portrait': { title: 'Portrait & Couple Photography | Yang Photography', description: 'Natural portrait and couple photography that feels relaxed, personal and true to you.' },
	'/travel': { title: 'Travel Photography | Yang Photography', description: 'Natural-light travel photography that preserves people, places and unplanned moments.' },
	'/product': { title: 'Product & Commercial Photography | Yang Photography', description: 'Clear, refined visual assets for products, brands and commercial projects.' },
	'/event': { title: 'Event Photography | Yang Photography', description: 'Documentary event photography for brand gatherings, talks and live experiences.' },
	'/service': { title: 'Photography Services | Yang Photography', description: 'Explore wedding, portrait, couple, registration, event and commercial photography services.' },
	'/booking': { title: 'Book a Photography Session | Yang Photography', description: 'Choose a photography service and preferred times to begin your booking enquiry.' },
	'/about': { title: 'About Yang | Yang Photography', description: 'Meet Yang, a photographer who documents stories through natural light and genuine interaction.' },
	'/links': { title: 'Yang Photography | Links', description: 'Find Yang Photography portfolio, services, booking and Instagram links.' },
});
const portfolioMetadata = pathname.startsWith('/portfolio/')
	? { title: 'Photography Portfolio | Yang Photography', description: 'Explore Yang Photography wedding, portrait, event and commercial photography portfolio.' }
	: undefined;
const resolvedMetadata = pageMetadata[pathname] || portfolioMetadata;
const seoTitle = resolvedMetadata?.title || title;
const seoDescription = resolvedMetadata?.description || description;

// 導覽定義
const navItems = [
	{ name: 'Home / 首頁', href: '/' },
	{ name: 'Wedding / 婚禮', href: '/wedding' },
	{ name: 'Registration / 登記', href: '/registration' },
	{ name: 'Portrait / 人像', href: '/portrait' },
	{ name: 'Travel / 旅遊', href: '/travel' },
	{ name: 'Product / 商品', href: '/product' },
	{ name: 'Event / 活動紀錄', href: '/event' },
	{ name: 'Service / 服務', href: '/service' },
	{ name: 'About / 關於', href: '/about' },
];
---

<!doctype html>
<html lang="zh-TW" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		
		<!-- SEO 核心標籤 -->
		<title>{seoTitle}</title>
		<meta name="description" content={seoDescription} />
		<link rel="canonical" href={canonicalURL} />

		<!-- Open Graph / 社群分享標籤 (LINE, FB, IG) -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={seoTitle} />
		<meta property="og:description" content={seoDescription} />
		<meta property="og:image" content={image} />
		<meta property="og:site_name" content="Yang Photography" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalURL} />
		<meta name="twitter:title" content={seoTitle} />
		<meta name="twitter:description" content={seoDescription} />
		<meta name="twitter:image" content={image} />

		<!-- Schema.org JSON-LD 結構化資料 -->
		<script type="application/ld+json" is:inline set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "Photographer",
			"name": "Yang Photography",
			"url": siteUrl,
			"image": image,
			"description": seoDescription,
			"address": {
				"@type": "PostalAddress",
				"addressCountry": "TW"
			},
			"sameAs": [
				"https://www.instagram.com/yang._.photo/"
			]
		})} />

		<!-- 載入核心字體 -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&family=Noto+Sans+TC:wght@100..900&display=swap" rel="stylesheet">
		
		<ClientRouter />
		<script is:inline>
			// 防止主題閃爍：立即套用 LocalStorage 中設定的主題
			const theme = localStorage.getItem('theme') || 'dark';
			document.documentElement.setAttribute('data-theme', theme);
		</script>
		<style is:global>
			@import "tailwindcss";

			:root {
				--font-base: 'Inter', 'Noto Sans TC', sans-serif;
				
				/* 暗黑主題變數 */
				--bg-primary: #000000;
				--text-primary: #e4e4e7;
				--text-secondary: #9ca3af;
				--card-bg: rgba(24, 24, 27, 0.4);
				--card-border: #27272a;
				--nav-bg-scroll: rgba(0, 0, 0, 0.75);
				--input-bg: rgba(9, 9, 11, 0.6);
				--input-border: #27272a;
				--footer-border: #18181b;
			}

			html[data-theme="light"] {
				/* 明亮燕麥奶白主題變數 */
				--bg-primary: #FAF8F5; /* 溫暖燕麥奶白 */
				--text-primary: #2D2D2A; /* 深炭灰，極具閱讀質感 */
				--text-secondary: #4B5563; /* 灰褐 */
				--card-bg: rgba(255, 255, 255, 0.85); /* 明亮卡片底色 */
				--card-border: #E5E7EB; /* border-zinc-200 */
				--nav-bg-scroll: rgba(250, 248, 245, 0.85); /* 滾動時的燕麥色背景 */
				--input-bg: rgba(255, 255, 255, 0.95); /* 白色輸入框 */
				--input-border: #D1D5DB;
				--footer-border: #E5E7EB;
			}

			html {
				overflow-y: scroll;
				scrollbar-gutter: stable;
			}

			body {
				background-color: var(--bg-primary);
				color: var(--text-primary);
				font-family: var(--font-base);
				font-weight: 300; /* 微幅加粗更易讀 */
				-webkit-font-smoothing: antialiased;
				transition: background-color 0.4s ease, color 0.4s ease;
			}

			h1, h2, h3, .brand-font {
				font-family: var(--font-base);
				font-weight: 200;
			}

			/* 圖片加載動畫：僅用於初始淡入，不影響後續 hover 特效 */
			.img-reveal {
				opacity: 0;
				transition: opacity 1.5s cubic-bezier(0.16, 1, 0.3, 1);
				will-change: opacity;
			}
			.img-reveal.loaded {
				opacity: unset; /* 動畫完成後釋放 opacity 控制權 */
			}

			#mobile-menu-overlay.active {
				opacity: 1;
				pointer-events: auto;
			}
			#mobile-menu-overlay.active .menu-item {
				transform: translateY(0);
				opacity: 1;
			}

			/* 滾動時 Header 的平滑毛玻璃與高度收縮過渡效果 */
			header {
				transition: background-color 0.6s cubic-bezier(0.16, 1, 0.3, 1), 
							backdrop-filter 0.6s cubic-bezier(0.16, 1, 0.3, 1), 
							border-color 0.6s cubic-bezier(0.16, 1, 0.3, 1),
							padding 0.6s cubic-bezier(0.16, 1, 0.3, 1);
			}
			header.active-scroll {
				background-color: rgba(0, 0, 0, 0.75) !important;
				backdrop-filter: blur(16px);
				-webkit-backdrop-filter: blur(16px);
				border-bottom: 1px solid rgba(63, 63, 70, 0.2); /* border-zinc-700/20 */
				padding-top: 1.25rem !important;
				padding-bottom: 1.25rem !important;
			}

			/* 導覽字體：移除硬描邊，改用極致柔和、無鋸齒的羽化發散投影 (Ambient Shadow) */
			.nav-link {
				text-shadow: 
					0 2px 8px rgba(0, 0, 0, 0.95),
					0 4px 16px rgba(0, 0, 0, 0.8);
			}

			/* 全域覆寫元件以支援雙主題變數 */
			.bg-black, body.bg-black {
				background-color: var(--bg-primary) !important;
				transition: background-color 0.4s ease;
			}
			.bg-zinc-900\/40, .bg-zinc-900\/50, .bg-zinc-900\/20, .bg-zinc-950\/20 {
				background-color: var(--card-bg) !important;
				transition: background-color 0.4s ease;
			}
			.border-zinc-800, .border-zinc-900, .border-zinc-800\/40, .border-zinc-800\/45 {
				border-color: var(--card-border) !important;
				transition: border-color 0.4s ease;
			}
			.bg-zinc-950\/60 {
				background-color: var(--input-bg) !important;
				transition: background-color 0.4s ease;
			}
			footer.border-zinc-900, div.border-zinc-900\/60 {
				border-color: var(--card-border) !important;
				transition: border-color 0.4s ease;
			}
			header.active-scroll {
				background-color: var(--nav-bg-scroll) !important;
				border-bottom-color: var(--card-border) !important;
			}
			.text-zinc-500, .text-zinc-400 {
				color: var(--text-secondary) !important;
				transition: color 0.4s ease;
			}
			.text-zinc-300, .text-zinc-200 {
				color: var(--text-primary) !important;
				transition: color 0.4s ease;
			}
			.text-white {
				color: var(--text-primary) !important;
				transition: color 0.4s ease;
			}
			.text-\[\#9CA3AF\] {
				color: var(--text-secondary) !important;
				transition: color 0.4s ease;
			}

			/* 明亮模式 (Light Theme) 下的專屬微調 */
			html[data-theme="light"] .nav-link {
				text-shadow: none !important;
				color: var(--text-primary) !important;
			}
			html[data-theme="light"] #menu-toggle span {
				background-color: #2D2D2A !important;
				box-shadow: none !important;
			}
			html[data-theme="light"] select option {
				background-color: #ffffff !important;
				color: #2D2D2A !important;
			}
			html[data-theme="light"] input[type="date"]::-webkit-calendar-picker-indicator {
				filter: invert(0.2) !important; /* 讓日曆 icon 在白底上為深灰 */
			}
			html[data-theme="light"] #mobile-menu-overlay {
				background-color: var(--bg-primary) !important;
			}
			html[data-theme="light"] input, 
			html[data-theme="light"] select, 
			html[data-theme="light"] textarea {
				color: #2D2D2A !important;
				background-color: var(--input-bg) !important;
			}
			html[data-theme="light"] input::placeholder, 
			html[data-theme="light"] textarea::placeholder {
				color: #9CA3AF !important;
			}
			html[data-theme="light"] input:focus,
			html[data-theme="light"] select:focus,
			html[data-theme="light"] textarea:focus {
				border-color: #d97706 !important;
			}
			html[data-theme="light"] #calendar-title {
				color: #2D2D2A !important;
			}
			html[data-theme="light"] .booking-calendar-wrapper span {
				color: #2D2D2A !important;
			}
			html[data-theme="light"] #booking-section h2 {
				color: #2D2D2A !important;
			}
			html[data-theme="light"] .date-time-row label {
				color: #4B5563 !important;
			}
			html[data-theme="light"] .date-time-row button.remove-date-btn {
				border-color: #D1D5DB !important;
				color: #4B5563 !important;
			}
			html[data-theme="light"] .date-time-row button.remove-date-btn:hover {
				border-color: #ef4444 !important;
				color: #ef4444 !important;
			}
			html[data-theme="light"] .date-time-row {
				background-color: rgba(0, 0, 0, 0.02) !important;
				border-color: #E5E7EB !important;
			}
			html[data-theme="light"] .bg-zinc-900\/60 {
				background-color: #ffffff !important;
				color: var(--text-secondary) !important;
				border-color: #E5E7EB !important;
			}
			html[data-theme="light"] #add-date-btn {
				color: #b45309 !important; /* 暗金色 / 深琥珀色 (amber-700) */
				transition: color 0.4s ease;
			}
			html[data-theme="light"] #add-date-btn span {
				border-color: rgba(180, 83, 9, 0.4) !important;
				transition: border-color 0.4s ease;
			}
			html[data-theme="light"] #add-date-btn:hover {
				color: #d97706 !important; /* hover 變為稍微亮的 amber-600 */
			}
			html[data-theme="light"] #add-date-btn:hover span {
				border-color: #d97706 !important;
			}

			/* 全域 amber 色系輔色在 Light theme 下轉暗覆寫，確保無障礙對比度 */
			html[data-theme="light"] .text-amber-300,
			html[data-theme="light"] .text-amber-400 {
				color: #b45309 !important;
			}
			html[data-theme="light"] .text-amber-500 {
				color: #d97706 !important;
			}
			html[data-theme="light"] .text-amber-200 {
				color: #b45309 !important;
			}
			html[data-theme="light"] .hover\:text-amber-200:hover {
				color: #d97706 !important;
			}
			html[data-theme="light"] .border-amber-500\/30 {
				border-color: rgba(180, 83, 9, 0.4) !important;
			}
			html[data-theme="light"] .bg-amber-400\/10 {
				background-color: rgba(180, 83, 9, 0.08) !important;
				border-color: rgba(180, 83, 9, 0.3) !important;
			}
			html[data-theme="light"] .bg-amber-500\/10 {
				background-color: rgba(180, 83, 9, 0.06) !important;
			}
			html[data-theme="light"] .border-amber-500\/80 {
				border-color: rgba(180, 83, 9, 0.7) !important;
			}
			/* 選擇時段按鈕勾選後狀態 */
			html[data-theme="light"] .has-\[\:checked\]\:border-amber-500\/60:has(:checked) {
				border-color: rgba(180, 83, 9, 0.7) !important;
				color: #b45309 !important;
				background-color: rgba(180, 83, 9, 0.06) !important;
			}

			/* 豁免任何疊加在滿版背景照片或卡片影像上的文字，使其在 Light theme 下依然維持亮白色 */
			html[data-theme="light"] .hero-text-container h1,
			html[data-theme="light"] .hero-text-container span,
			html[data-theme="light"] .hero-text-container p,
			html[data-theme="light"] .absolute h3 {
				color: #ffffff !important;
			}
			html[data-theme="light"] .hero-text-container .text-zinc-400 {
				color: #9CA3AF !important;
			}

			/* 「客製化方案」卡片在 Light theme 下轉深，提供更佳對比度 */
			html[data-theme="light"] .from-amber-500\/10 {
				--tw-gradient-from: rgba(180, 83, 9, 0.05) !important;
				border-color: rgba(180, 83, 9, 0.25) !important;
			}
			html[data-theme="light"] .bg-white\/5 {
				background-color: var(--input-bg) !important;
				border-color: var(--card-border) !important;
				color: var(--text-primary) !important;
			}
			html[data-theme="light"] .border-white\/10 {
				border-color: var(--card-border) !important;
			}

			/* 複製成功通知在 Light theme 下的主題色調與毛玻璃優化 */
			html[data-theme="light"] #email-toast {
				background-color: rgba(255, 255, 255, 0.9) !important;
				color: #b45309 !important;
				border-color: rgba(180, 83, 9, 0.3) !important;
				box-shadow: 0 10px 30px rgba(180, 83, 9, 0.12) !important;
				backdrop-filter: blur(8px) !important;
				-webkit-backdrop-filter: blur(8px) !important;
			}

			/* 預設新竹標籤的主題色彩自適應 (防範切換主題不換色 Bug) */
			.loc-badge-hsinchu {
				background-color: rgba(24, 24, 27, 0.6) !important; /* 暗色模式深灰底 */
				border-color: rgba(63, 63, 70, 0.3) !important;
			}
			html[data-theme="light"] .loc-badge-hsinchu {
				background-color: #ffffff !important; /* 亮色模式純白底 */
				border-color: rgba(228, 228, 231, 0.8) !important; /* border-zinc-200 */
				color: #71717a !important; /* text-zinc-500 */
			}

			/* Uiverse.io 靈感：高奢極簡流光按鈕與脈衝質感 */
			.uiverse-glow-btn {
				position: relative;
				transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
			}
			.uiverse-glow-btn::after {
				content: '';
				position: absolute;
				inset: -2px;
				border-radius: 9999px;
				background: linear-gradient(135deg, rgba(245, 158, 11, 0.6), transparent 50%, rgba(245, 158, 11, 0.4));
				opacity: 0;
				z-index: -1;
				transition: opacity 0.5s ease, filter 0.5s ease;
				filter: blur(8px);
			}
			.uiverse-glow-btn:hover::after {
				opacity: 1;
				filter: blur(14px);
			}

			/* 高奢精品靈感：3D Tilt 純幾何視差 (零色彩污染，100% 保留攝影作品真實膚色與白平衡) */
			.tilt-card {
				transform-style: preserve-3d;
				perspective: 1000px;
				will-change: transform;
				transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
			}

			/* Clear keyboard navigation and readable category labels on touch devices. */
			a:focus-visible,
			button:focus-visible,
			input:focus-visible,
			select:focus-visible,
			textarea:focus-visible {
				outline: 2px solid #fbbf24;
				outline-offset: 4px;
			}

			@media (hover: none) {
				.tilt-card > .absolute {
					opacity: 1 !important;
				}
				.tilt-card > .absolute > div,
				.tilt-card > .absolute h3 {
					transform: translateY(0) !important;
				}
			}

			@media (prefers-reduced-motion: reduce) {
				*, *::before, *::after {
					animation-duration: 0.01ms !important;
					animation-iteration-count: 1 !important;
					scroll-behavior: auto !important;
					transition-duration: 0.01ms !important;
				}
			}
		</style>
	</head>
	<body class="bg-black text-[#9CA3AF] font-sans font-[200] min-h-screen flex flex-col selection:bg-zinc-800 selection:text-white antialiased relative">
		
		{ !minimal && (
			<header class="fixed top-0 left-0 w-full py-8 md:py-10 px-8 md:px-16 z-50 pointer-events-none border-b border-transparent">
				<div class="max-w-7xl mx-auto w-full">
					<nav class="flex justify-center items-center pointer-events-auto relative w-full">
						<!-- 桌機版選單：移除大黑底，回歸極簡文字加黑框描邊 -->
						<ul class="hidden md:flex flex-wrap justify-center items-center gap-x-3 lg:gap-x-6 gap-y-2 text-[10px] lg:text-[11px] tracking-[0.15em] font-medium uppercase">
							{navItems.map((item) => (
								<li>
									<a href={item.href} class={`nav-link text-zinc-300 hover:text-amber-400 transition-colors duration-500 py-1 border-b border-transparent hover:border-amber-400/30 ${pathname === item.href ? 'text-amber-400 !border-amber-400/50 font-bold' : ''}`}>
										{item.name}
									</a>
								</li>
							))}
						</ul>
						
						<!-- 桌機主題切換按鈕：採用絕對定位，優雅地靠右，不干擾選單居中 -->
						<button id="theme-toggle" class="hidden md:flex items-center justify-center w-8 h-8 rounded-full border border-zinc-800/40 bg-zinc-900/10 hover:bg-zinc-800/30 hover:border-amber-400/30 transition-all duration-300 nav-link absolute right-0 text-sm tracking-widest text-zinc-300 hover:text-amber-400 cursor-pointer pointer-events-auto" title="切換明暗主題">
							<span id="theme-icon">☀️</span>
						</button>

						<!-- 手機版選單按鈕：同樣移除實心黑底，改為帶極細黑描邊的選單字體 -->
						<button id="menu-toggle" class="nav-link md:hidden text-zinc-200 text-[11px] tracking-[0.4em] uppercase font-medium flex items-center gap-4 py-2 hover:text-amber-400 transition-colors duration-300 cursor-pointer">
							<span class="w-8 h-px bg-white/30 shadow-[0_1px_2px_rgba(0,0,0,0.8)]"></span>MENU / 選單<span class="w-8 h-px bg-white/30 shadow-[0_1px_2px_rgba(0,0,0,0.8)]"></span>
						</button>
					</nav>
				</div>
			</header>
		)}

		{ minimal && (
			/* LinkTree 專用右上角精緻懸浮切換按鈕 */
			<div class="fixed top-6 right-6 z-50">
				<button id="theme-toggle" class="flex items-center justify-center w-9 h-9 rounded-full border border-zinc-800/40 bg-zinc-900/10 hover:bg-zinc-800/35 hover:border-amber-500/30 transition-all duration-300 nav-link text-sm text-zinc-300 hover:text-amber-400 cursor-pointer shadow-[0_4px_20px_rgba(0,0,0,0.35)]" title="切換明暗主題">
					<span id="theme-icon">☀️</span>
				</button>
			</div>
		)}

		{ !minimal && (
			<div id="mobile-menu-overlay" class="fixed inset-0 bg-black z-[100] opacity-0 pointer-events-none transition-opacity duration-700 flex flex-col items-center justify-center p-8 overflow-y-auto">
				<button id="menu-close" class="absolute top-10 right-10 text-zinc-500 hover:text-white text-3xl font-thin">&times;</button>
				<ul class="flex flex-col items-center gap-8 text-center">
					{navItems.map((item, index) => (
						<li class="menu-item opacity-0 transform translate-y-4 transition-all duration-700" style={`transition-delay: ${index * 50}ms`}>
							<a href={item.href} class={`text-xl font-light tracking-[0.2em] uppercase transition-colors hover:text-white ${pathname === item.href ? 'text-white' : 'text-zinc-500'}`}>{item.name}</a>
						</li>
					))}
					<!-- 手機主題切換按鈕 -->
					<li class="menu-item opacity-0 transform translate-y-4 transition-all duration-700" style={`transition-delay: ${navItems.length * 50}ms`}>
						<button id="theme-toggle-mobile" class="mt-4 px-6 py-2.5 border border-zinc-800 rounded-full text-zinc-300 text-[11px] tracking-[0.2em] flex items-center gap-2 hover:border-white transition-colors cursor-pointer">
							<span id="theme-icon-mobile">☀️ LIGHT MODE</span>
						</button>
					</li>
				</ul>
			</div>
		)}

		<main class={`flex-grow w-full ${fullWidth ? '' : (minimal ? 'pt-24 pb-20 px-4 md:px-8 max-w-xl mx-auto' : 'pt-32 px-8 md:px-16 max-w-7xl mx-auto')}`}>
			<slot />
		</main>

		{ !minimal && (
			<footer class="w-full py-20 px-8 md:px-16 max-w-7xl mx-auto border-t border-zinc-900">
				<p class="text-[10px] tracking-widest uppercase text-zinc-600">&copy; 2026 YANG PHOTOGRAPHY</p>
			</footer>
		)}

		<!-- 展覽級升級版全域燈箱 (含頂部計數器、導覽與滑動) -->
		<div id="lightbox" class="fixed inset-0 bg-black/95 z-[100] hidden opacity-0 transition-opacity duration-500 flex flex-col items-center justify-between p-4 md:p-8 select-none">
			<div id="lightbox-backdrop" class="absolute inset-0 cursor-zoom-out"></div>
			
			<!-- 頂部列 (計數器 + 關閉) -->
			<div class="relative z-20 w-full max-w-7xl flex items-center justify-between px-2 md:px-4 pointer-events-auto">
				<div class="flex items-center gap-3">
					<span id="lightbox-counter" class="text-[10px] md:text-xs font-mono tracking-widest text-amber-400 bg-amber-500/10 border border-amber-500/30 px-3 py-1 rounded-full">
						1 / 1
					</span>
					<span id="lightbox-caption" class="text-[10px] md:text-xs tracking-widest text-zinc-400 font-light truncate max-w-[180px] md:max-w-md">
						Yang Photography
					</span>
				</div>
				<button id="lightbox-close" class="text-zinc-400 hover:text-white text-3xl font-extralight transition-colors duration-300 p-2 cursor-pointer" title="關閉 (Esc)">
					&times;
				</button>
			</div>

			<!-- 中央圖片與左右按鈕 -->
			<div class="relative z-10 flex-grow w-full max-w-7xl flex items-center justify-between my-2 overflow-hidden pointer-events-none">
				<!-- 上一張 -->
				<button id="lightbox-prev" class="pointer-events-auto text-zinc-500 hover:text-white text-3xl md:text-5xl p-4 transition-colors duration-300 cursor-pointer hidden sm:flex items-center justify-center" title="上一張 (←)">
					‹
				</button>

				<!-- 主大圖 -->
				<div class="flex-grow flex items-center justify-center h-full w-full pointer-events-auto">
					<img id="lightbox-img" src="" alt="Gallery Image" class="max-w-full max-h-[80vh] object-contain shadow-[0_0_50px_rgba(0,0,0,0.8)] scale-95 transition-all duration-300" />
				</div>

				<!-- 下一張 -->
				<button id="lightbox-next" class="pointer-events-auto text-zinc-500 hover:text-white text-3xl md:text-5xl p-4 transition-colors duration-300 cursor-pointer hidden sm:flex items-center justify-center" title="下一張 (→)">
					›
				</button>
			</div>

			<!-- 底部提示 -->
			<div class="relative z-20 text-[9px] md:text-[10px] text-zinc-600 tracking-[0.2em] uppercase font-light pointer-events-none">
				Use ← → keys or swipe to navigate
			</div>
		</div>

		<script>
			// 滾動收縮與毛玻璃導覽列事件處理（全域單一監聽器，防範 SPA 切換頁面記憶體洩漏）
			let currentHeader: HTMLElement | null = null;
			const handleScroll = () => {
				if (!currentHeader) return;
				if (window.scrollY > 20) {
					currentHeader.classList.add('active-scroll');
				} else {
					currentHeader.classList.remove('active-scroll');
				}
			};
			window.addEventListener('scroll', handleScroll);

			// 1. 全域選單及載入動畫 (每次換頁均需重新對當前 DOM 進行初始化)
			const init = () => {
				// 更新當前頁面的 header 引用並進行初始檢測
				currentHeader = document.querySelector('header');
				handleScroll();

				// 選單
				const toggle = document.getElementById('menu-toggle');
				const close = document.getElementById('menu-close');
				const overlay = document.getElementById('mobile-menu-overlay');
				const openMenu = () => { overlay?.classList.add('active'); document.body.style.overflow = 'hidden'; };
				const closeMenu = () => { overlay?.classList.remove('active'); document.body.style.overflow = ''; };
				
				if (toggle && !toggle.dataset.bound) {
					toggle.dataset.bound = 'true';
					toggle.addEventListener('click', openMenu);
				}
				if (close && !close.dataset.bound) {
					close.dataset.bound = 'true';
					close.addEventListener('click', closeMenu);
				}
				document.querySelectorAll('#mobile-menu-overlay a').forEach(link => {
					if (!(link as HTMLElement).dataset.bound) {
						(link as HTMLElement).dataset.bound = 'true';
						link.addEventListener('click', closeMenu);
					}
				});
				if (overlay && !overlay.dataset.bound) {
					overlay.dataset.bound = 'true';
					overlay.addEventListener('click', (e) => {
						if (e.target === overlay) closeMenu();
					});
				}

				// 圖片加載優化
				const images = document.querySelectorAll('img');
				images.forEach(img => {
					img.decoding = 'async';
					if (!img.classList.contains('lightbox-trigger')) {
						img.classList.add('img-reveal');
						
						const handleLoad = () => {
							img.classList.add('loaded');
							setTimeout(() => {
								img.classList.remove('img-reveal', 'loaded');
							}, 1500); 
						};

						if (img.complete) handleLoad();
						else img.addEventListener('load', handleLoad);
					}
				});

				// 主題切換初始化 (修正重複綁定 Event Listener Bug)
				const themeToggle = document.getElementById('theme-toggle');
				const themeToggleMobile = document.getElementById('theme-toggle-mobile');
				const themeIcon = document.getElementById('theme-icon');
				const themeIconMobile = document.getElementById('theme-icon-mobile');

				const updateToggleUI = (theme: string) => {
					if (themeIcon) {
						themeIcon.textContent = theme === 'light' ? '🌙' : '☀️';
					}
					if (themeIconMobile) {
						themeIconMobile.textContent = theme === 'light' ? '🌙 DARK MODE' : '☀️ LIGHT MODE';
					}
				};

				// 每次頁面載入時根據當前狀態更新按鈕圖示
				const currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
				updateToggleUI(currentTheme);

				const toggleTheme = () => {
					const theme = document.documentElement.getAttribute('data-theme') || 'dark';
					const nextTheme = theme === 'light' ? 'dark' : 'light';
					document.documentElement.setAttribute('data-theme', nextTheme);
					localStorage.setItem('theme', nextTheme);
					updateToggleUI(nextTheme);
				};

				if (themeToggle && !themeToggle.dataset.bound) {
					themeToggle.dataset.bound = 'true';
					themeToggle.addEventListener('click', toggleTheme);
				}
				if (themeToggleMobile && !themeToggleMobile.dataset.bound) {
					themeToggleMobile.dataset.bound = 'true';
					themeToggleMobile.addEventListener('click', toggleTheme);
				}

				// 3D Tilt 視差微互動與動態反光
				init3DTilt();
			};
			document.addEventListener('astro:page-load', init);

			const init3DTilt = () => {
				if (window.matchMedia('(pointer: coarse)').matches) return;

				const cards = document.querySelectorAll('.tilt-card');
				cards.forEach(card => {
					const el = card as HTMLElement;
					if (el.dataset.tiltBound) return;
					el.dataset.tiltBound = 'true';

					el.addEventListener('mousemove', (e: MouseEvent) => {
						const rect = el.getBoundingClientRect();
						const x = e.clientX - rect.left;
						const y = e.clientY - rect.top;
						const centerX = rect.width / 2;
						const centerY = rect.height / 2;

						const rotateX = ((y - centerY) / centerY) * -6;
						const rotateY = ((x - centerX) / centerX) * 6;

						el.style.transform = `perspective(1000px) rotateX(${rotateX.toFixed(2)}deg) rotateY(${rotateY.toFixed(2)}deg) scale3d(1.02, 1.02, 1.02)`;
					});

					el.addEventListener('mouseleave', () => {
						el.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)';
					});
				});
			};

			// 2. Astro SPA 換頁後的主題重新同步與按鈕狀態更新
			document.addEventListener('astro:after-swap', () => {
				const theme = localStorage.getItem('theme') || 'dark';
				document.documentElement.setAttribute('data-theme', theme);
				
				const themeIcon = document.getElementById('theme-icon');
				const themeIconMobile = document.getElementById('theme-icon-mobile');
				if (themeIcon) {
					themeIcon.textContent = theme === 'light' ? '🌙' : '☀️';
				}
				if (themeIconMobile) {
					themeIconMobile.textContent = theme === 'light' ? '🌙 DARK MODE' : '☀️ LIGHT MODE';
				}
			});

			// 3. 全域展覽級 Lightbox 控制邏輯 (含圖片預載 Preloading、多圖相簿、鍵盤切換與觸控劃動)
			let currentGallery: Array<{ src: string; rawSrc?: string; alt?: string }> = [];
			let currentIndex = 0;
			const preloadedCache = new Set<string>();

			const preloadImage = (url?: string) => {
				if (!url || preloadedCache.has(url)) return;
				preloadedCache.add(url);
				const img = new Image();
				img.src = url;
			};

			const updateLightboxImage = () => {
				const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
				const counter = document.getElementById('lightbox-counter');
				const caption = document.getElementById('lightbox-caption');
				if (!lightboxImg || currentGallery.length === 0) return;

				const item = currentGallery[currentIndex];
				const targetSrc = item.rawSrc || item.src;

				if (counter) counter.textContent = `${currentIndex + 1} / ${currentGallery.length}`;
				if (caption) caption.textContent = item.alt || 'Yang Photography';

				// 🚀 核心極致優化 1：靜默預載相鄰的「下一張」與「上一張」圖片進瀏覽器快取 (Memory Cache)
				const nextIndex = (currentIndex + 1) % currentGallery.length;
				const prevIndex = (currentIndex - 1 + currentGallery.length) % currentGallery.length;
				preloadImage(currentGallery[nextIndex].rawSrc || currentGallery[nextIndex].src);
				preloadImage(currentGallery[prevIndex].rawSrc || currentGallery[prevIndex].src);

				// 🚀 核心極致優化 2：移除固定的 150ms 延遲，實現 0 毫秒極速切換
				const applyLoaded = () => {
					lightboxImg.classList.remove('scale-95', 'opacity-0');
				};

				lightboxImg.classList.add('scale-95', 'opacity-0');
				
				// 切換 src
				lightboxImg.src = targetSrc;

				if (lightboxImg.complete) {
					requestAnimationFrame(applyLoaded);
				} else {
					lightboxImg.onload = applyLoaded;
				}
			};

			const openLightbox = (index: number, gallery: Array<{ src: string; rawSrc?: string; alt?: string }>) => {
				const lightbox = document.getElementById('lightbox');
				if (!lightbox || gallery.length === 0) return;

				currentGallery = gallery;
				currentIndex = index;

				lightbox.classList.remove('hidden');
				document.body.style.overflow = 'hidden';
				updateLightboxImage();

				requestAnimationFrame(() => {
					lightbox.classList.add('opacity-100');
				});
			};

			const closeLightbox = () => {
				const lightbox = document.getElementById('lightbox');
				const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
				if (!lightbox) return;
				
				lightbox.classList.remove('opacity-100');
				if (lightboxImg) lightboxImg.classList.add('scale-95');
				
				setTimeout(() => {
					lightbox.classList.add('hidden');
					document.body.style.overflow = '';
				}, 400);
			};

			const showPrev = () => {
				if (currentGallery.length <= 1) return;
				currentIndex = (currentIndex - 1 + currentGallery.length) % currentGallery.length;
				updateLightboxImage();
			};

			const showNext = () => {
				if (currentGallery.length <= 1) return;
				currentIndex = (currentIndex + 1) % currentGallery.length;
				updateLightboxImage();
			};

			// 全域點擊監聽 (Event Delegation)
			document.addEventListener('click', (e) => {
				const target = e.target as HTMLElement;
				
				// 觸發開啟燈箱
				const trigger = target.closest('.lightbox-trigger') as HTMLImageElement;
				if (trigger) {
					const allTriggers = Array.from(document.querySelectorAll('.lightbox-trigger')) as HTMLImageElement[];
					const gallery = allTriggers.map(img => ({
						src: img.src,
						rawSrc: img.getAttribute('data-raw') || undefined,
						alt: img.alt || img.title || 'Yang Photography'
					}));
					const index = allTriggers.indexOf(trigger);
					openLightbox(index >= 0 ? index : 0, gallery);
					return;
				}

				// 燈箱內部控制項
				if (target.id === 'lightbox-close' || target.id === 'lightbox-backdrop') {
					closeLightbox();
				} else if (target.id === 'lightbox-prev' || target.closest('#lightbox-prev')) {
					showPrev();
				} else if (target.id === 'lightbox-next' || target.closest('#lightbox-next')) {
					showNext();
				}
			});

			// 全域鍵盤操控 (Esc 關閉, ← 上一張, → 下一張)
			window.addEventListener('keydown', (e) => {
				const lightbox = document.getElementById('lightbox');
				if (!lightbox || lightbox.classList.contains('hidden')) return;

				if (e.key === 'Escape') closeLightbox();
				else if (e.key === 'ArrowLeft') showPrev();
				else if (e.key === 'ArrowRight') showNext();
			});

			// 手機端 Touch Swipe 劃動切換
			let touchStartX = 0;
			let touchStartY = 0;
			
			window.addEventListener('touchstart', (e) => {
				const lightbox = document.getElementById('lightbox');
				if (!lightbox || lightbox.classList.contains('hidden')) return;
				touchStartX = e.touches[0].clientX;
				touchStartY = e.touches[0].clientY;
			}, { passive: true });

			window.addEventListener('touchend', (e) => {
				const lightbox = document.getElementById('lightbox');
				if (!lightbox || lightbox.classList.contains('hidden')) return;
				
				const touchEndX = e.changedTouches[0].clientX;
				const touchEndY = e.changedTouches[0].clientY;
				const deltaX = touchEndX - touchStartX;
				const deltaY = touchEndY - touchStartY;

				if (Math.abs(deltaX) > 40 && Math.abs(deltaX) > Math.abs(deltaY)) {
					if (deltaX > 0) showPrev();
					else showNext();
				}
			}, { passive: true });
		</script>
	</body>
</html>
