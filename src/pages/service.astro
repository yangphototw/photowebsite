---
import Layout from '../layouts/Layout.astro';

const services = [
  { title: 'Weddings', subtitle: '婚禮紀錄', price: 'NT$ 12,000 起', bookingService: '婚禮記錄', description: '從儀式到宴會，保留當日自然且不被打擾的情緒與細節。', details: ['儀式與宴會紀錄', '交件內容依檔期與需求確認'] },
  { title: 'Portraits', subtitle: '個人寫真', price: 'NT$ 2,000 起', bookingService: '個人人像', description: '以舒服的節奏拍出有個人感的照片，適合日常、形象與紀念。', details: ['拍攝前簡短溝通', '可依需求討論地點與風格'] },
  { title: 'Couples', subtitle: '情侶寫真', price: 'NT$ 3,500 起', bookingService: '情侶人像', description: '不必刻意擺拍，留下兩人最自然的互動和相處方式。', details: ['自然互動引導', '適合紀念日或日常約會'] },
  { title: 'Registration', subtitle: '登記寫真', price: 'NT$ 5,000 起', bookingService: '登記寫真', description: '記錄登記這天的儀式感，也保留家人和朋友在場的片刻。', details: ['登記流程與合影', '可加拍附近街景或日常片段'] },
  { title: 'Events', subtitle: '活動紀錄', price: '報價請洽詢', bookingService: '活動記錄', description: '活動現場、品牌聚會與講座，專注捕捉真實的節奏與現場氛圍。', details: ['依時數與規模報價', '交件方式可事前確認'] },
  { title: 'Commercial', subtitle: '商業攝影', price: '報價請洽詢', bookingService: '商業攝影', description: '為商品、品牌與專案建立清楚、有質感並能被使用的視覺素材。', details: ['先確認用途與視覺方向', '可討論棚拍、場景與交件規格'] },
];
---

<Layout title="Services | Yang Photography" description="Yang Photography 的婚禮、人像、情侶、活動與商業攝影方案。">
  <main class="min-h-screen bg-zinc-950 text-zinc-100 selection:bg-amber-400 selection:text-zinc-950">
    <section class="relative overflow-hidden px-6 pt-32 pb-16 md:px-12 md:pt-44 md:pb-24">
      <div class="absolute inset-0 pointer-events-none opacity-40" style="background: radial-gradient(circle at 50% 0%, rgba(245, 158, 11, 0.14), transparent 45%);"></div>
      <div class="relative max-w-5xl mx-auto text-center">
        <p class="text-amber-300/80 text-xs tracking-[0.35em] uppercase mb-5">Services / 服務方案</p>
        <h1 class="font-serif text-5xl md:text-7xl tracking-tight">Choose a starting point.</h1>
        <p class="mt-6 max-w-2xl mx-auto text-zinc-400 leading-relaxed">選擇最接近需求的方案即可。所有詢問會進入同一個精簡的預約流程，再一起確認日期、地點與拍攝細節。</p>
        <div class="mt-9 flex flex-wrap justify-center gap-3 text-xs tracking-wide text-zinc-300">
          <span class="rounded-full border border-white/10 bg-white/5 px-4 py-2">01 選擇方案</span>
          <span class="rounded-full border border-white/10 bg-white/5 px-4 py-2">02 挑選方便時段</span>
          <span class="rounded-full border border-white/10 bg-white/5 px-4 py-2">03 送出詢問</span>
        </div>
      </div>
    </section>

    <section class="px-6 pb-24 md:px-12 md:pb-32">
      <div class="max-w-6xl mx-auto grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {services.map((service) => (
          <article class="group flex flex-col rounded-2xl border border-white/10 bg-white/[0.03] p-7 transition-colors duration-300 hover:border-amber-500/40 hover:bg-amber-500/[0.05]">
            <div class="flex items-start justify-between gap-4"><div><p class="text-[11px] tracking-[0.25em] uppercase text-amber-300/75">{service.title}</p><h2 class="mt-2 font-serif text-3xl">{service.subtitle}</h2></div><span class="shrink-0 text-sm text-amber-200">{service.price}</span></div>
            <p class="mt-6 text-sm leading-7 text-zinc-400">{service.description}</p>
            <ul class="mt-5 space-y-2 text-sm text-zinc-300">{service.details.map((detail) => <li class="flex gap-2"><span class="text-amber-300">—</span>{detail}</li>)}</ul>
            <a href={`/booking?service=${encodeURIComponent(service.bookingService)}`} class="mt-8 inline-flex items-center justify-between rounded-full border border-amber-500/40 bg-amber-500/10 px-5 py-3 text-xs font-bold tracking-widest text-amber-200 transition-all duration-300 hover:border-amber-400/70 hover:bg-amber-500/20">選擇此方案 <span aria-hidden="true">↗</span></a>
          </article>
        ))}
      </div>
      <div class="max-w-6xl mx-auto mt-8 rounded-2xl border border-white/10 bg-white/[0.03] p-7 md:p-9 flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
        <div><p class="text-xs tracking-[0.25em] uppercase text-amber-300/75">Not sure yet?</p><h2 class="mt-2 font-serif text-3xl">還不確定方案？</h2><p class="mt-2 text-sm text-zinc-400">直接選「客製化方案」，告訴我你想拍什麼即可。</p></div>
        <a href="/booking?service=%E5%AE%A2%E8%A3%BD%E5%8C%96%E6%96%B9%E6%A1%88" class="inline-flex shrink-0 items-center justify-center gap-2 rounded-full border border-amber-500/40 bg-amber-500/10 px-6 py-3 text-xs font-bold tracking-widest text-amber-200 transition-all duration-300 hover:border-amber-400/70 hover:bg-amber-500/20">開始詢問 <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </main>
</Layout>
