---
import Layout from '../layouts/Layout.astro';
import fs from 'node:fs';
import path from 'node:path';

// 讀取 Booking 資料
const readJson = (filePath: string) => {
	try {
		const fullPath = path.resolve(filePath);
		if (fs.existsSync(fullPath)) return JSON.parse(fs.readFileSync(fullPath, 'utf-8'));
	} catch (e) {}
	return {};
};

const bookingData = readJson('src/data/booking.json');

const services = [
    {
        title: "Weddings / 婚禮紀錄",
        price: "NT$ 12,000 起",
        description: "比起刻意的擺拍，更偏好捕捉那些不經意間流露的真摯情感。紀錄婚禮當天最純粹、最有溫度的自然瞬間。",
        features: ["全數專業調色照片", "無負擔自然捕捉", "Google 相簿高效呈現", "兩周內快速交付，延續婚禮溫度"]
    },
    {
        title: "Portraits / 個人寫真",
        price: "NT$ 2,000",
        description: "探索光影與氣質的交織，打造專屬於您的視覺名片。",
        features: ["1 ~ 1.5 小時拍攝", "含妝髮建議", "專業調色檔案交付", "適合個人形象或生活感紀錄"]
    },
    {
        title: "Couples / 情侶寫真",
        price: "NT$ 3,500",
        description: "紀錄兩人間最自然的互動與情感，捕捉那份專屬的甜蜜氣息。",
        features: ["1 ~ 1.5 小時拍攝", "互動引導拍攝", "專業調色檔案交付", "適合紀念日或婚前紀錄"]
    },
    {
        title: "Registration / 登記寫真",
        price: "NT$ 5,000",
        description: "紀錄最簡約而真摯的法律見證，讓平凡的一天成為永恆。",
        features: ["登記全程側拍", "戶外生活感類婚紗", "兩周內快速交付", "急件處理服務"]
    },
    {
        title: "Events / 活動紀錄",
        price: "報價請洽詢",
        description: "精準捕捉品牌活動、派對或講座的精彩瞬間，展現動態的張力。",
        features: ["商業記者會/派對/講座", "快速交付預覽圖", "專業動態捕捉"]
    },
    {
        title: "Product / 商業攝影",
        price: "報價請洽詢",
        description: "提升產品的視覺價值，讓質感說話。",
        features: ["美食/空間/商品", "棚內燈光佈置", "高精度細節呈現", "版權授權使用"]
    }
];
---

<Layout title="Service | 服務項目">
	<!-- 頁面標題 -->
	<section class="py-8 md:py-12 animate-fade-in text-center flex flex-col items-center">
		<div class="flex items-center gap-3 text-zinc-500 font-light tracking-[0.4em] text-[10px] uppercase">
			<span>Service / 服務項目</span>
		</div>
        <div class="h-px w-12 bg-zinc-800 mt-4"></div>
	</section>

	<!-- 服務方案網格 (優化手機間距與內距) -->
	<section class="pb-12 animate-fade-in">
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
			{services.map((s, index) => (
				<div class="group p-6 md:p-12 bg-zinc-900/40 backdrop-blur-md border border-zinc-800 rounded-3xl hover:border-amber-500/30 transition-all duration-700 flex flex-col justify-between">
					<div>
						<h3 class="text-lg md:text-2xl font-light text-white tracking-tight mb-2 group-hover:text-amber-200 transition-colors">
							{s.title}
						</h3>
						<div class="text-amber-500/80 text-[10px] md:text-xs tracking-widest font-bold mb-4 md:mb-6 italic">{s.price}</div>
						<p class="text-zinc-500 text-xs md:text-sm font-light leading-relaxed mb-6 md:mb-8">
							{s.description}
						</p>
						<ul class="space-y-2 md:space-y-3 mb-8 md:mb-10">
							{s.features.map(f => (
								<li class="flex items-center gap-3 text-[10px] md:text-[11px] text-zinc-400 tracking-wide">
									<span class="w-1 h-1 rounded-full bg-amber-500/50"></span>
									{f}
								</li>
							))}
						</ul>
					</div>
					<a href="#booking-form" data-service={s.title.split(' / ')[1]} class="inquiry-btn mt-auto block text-center py-3 md:py-4 border border-zinc-800 text-zinc-500 text-[9px] md:text-[10px] tracking-[0.3em] uppercase hover:bg-white hover:text-black hover:border-white transition-all duration-500 rounded-full">
						Inquiry / 預約諮詢
					</a>
				</div>
			))}
		</div>
	</section>

    <!-- 客製化方案 (手機版寬度自適應) -->
    <section class="pb-32 animate-fade-in flex justify-center px-4 md:px-0">
        <div class="w-full max-w-lg group p-8 md:p-12 bg-gradient-to-br from-amber-500/10 to-transparent border border-amber-500/20 rounded-3xl flex flex-col justify-center items-center text-center">
            <h3 class="text-xl font-light text-amber-200 tracking-tight mb-4">Customized / 客製化方案</h3>
            <p class="text-zinc-500 text-xs font-light leading-relaxed mb-8">
                上述方案皆可依需求微調，<br />如有特殊拍攝需求或大規模合作歡迎聯繫。
            </p>
            <div class="flex flex-col w-full gap-4">
                <button 
                    data-email="yang.photo999@gmail.com"
                    class="send-email-btn px-8 py-4 bg-white/5 border border-white/10 text-white text-[10px] tracking-[0.3em] uppercase hover:bg-white hover:text-black transition-all duration-500 rounded-full cursor-pointer"
                >
                    Email Inquiry
                </button>
                <a href="https://www.instagram.com/yang._.photo/" target="_blank" class="px-8 py-4 bg-amber-500 text-black text-[10px] tracking-[0.3em] uppercase hover:bg-amber-400 transition-all duration-500 rounded-full font-bold">
                    DM on Instagram
                </a>
            </div>
        </div>
    </section>

	<!-- 預約月曆與表單區區塊 -->
	<div id="booking-section" class="border-t border-zinc-900/60 pt-16 pb-32 animate-fade-in">
		<h2 class="text-[10px] text-zinc-500 tracking-[0.4em] uppercase mb-12 text-center">— Booking / 預約狀況 —</h2>
		
		<div class="booking-calendar-wrapper max-w-4xl mx-auto rounded-2xl border border-zinc-800 bg-zinc-900/40 backdrop-blur-md p-6 md:p-8 shadow-[0_0_50px_rgba(0,0,0,0.6)]">
			<!-- 月曆頂部導覽 -->
			<div class="flex items-center justify-between mb-8 px-2">
				<button id="prev-month" class="text-zinc-500 hover:text-white text-[10px] tracking-widest uppercase transition-colors duration-300 cursor-pointer">← Prev / 上月</button>
				<h3 id="calendar-title" class="brand-font text-white text-sm md:text-base tracking-[0.2em] uppercase font-light">July 2026</h3>
				<button id="next-month" class="text-zinc-500 hover:text-white text-[10px] tracking-widest uppercase transition-colors duration-300 cursor-pointer">Next / 下月 →</button>
			</div>
			
			<!-- 外縣市行程公告欄 (方案 B：自動整併連續日期地點) -->
			<div id="location-announcements" class="mb-6 px-4 py-3 bg-sky-500/10 border border-sky-500/20 text-sky-200 text-[10px] md:text-xs tracking-widest uppercase rounded-xl flex flex-col gap-1.5 hidden">
				<!-- 由 JS 動態填充 -->
			</div>

			<!-- 星期欄 -->
			<div class="grid grid-cols-7 gap-2 text-center text-[9px] tracking-widest text-zinc-400 uppercase mb-4 font-bold">
				<div>Sun</div><div>Mon</div><div>Tue</div><div>Wed</div><div>Thu</div><div>Fri</div><div>Sat</div>
			</div>
			
			<!-- 日子網格 -->
			<div id="calendar-days" class="grid grid-cols-7 gap-2" data-booking={JSON.stringify(bookingData)}>
				<!-- 由 JS 動態填充 -->
			</div>
			
			<!-- 圖例說明 (優化大小與藍色標記) -->
			<div class="grid grid-cols-1 sm:grid-cols-3 gap-6 max-w-2xl mx-auto mt-8 pt-6 border-t border-zinc-900/50 text-[10px] md:text-xs text-zinc-400 tracking-wider">
				<div class="flex items-center justify-center gap-3">
					<span class="px-2.5 py-0.5 text-[8px] md:text-[9px] text-amber-300 bg-amber-400/10 border border-amber-500/30 rounded font-normal">早上</span>
					<span class="text-zinc-300">Available / 可預約</span>
				</div>
				<div class="flex items-center justify-center gap-3">
					<span class="px-2.5 py-0.5 text-[8px] md:text-[9px] text-zinc-500 bg-zinc-900/60 border border-zinc-800/40 rounded line-through opacity-50">下午</span>
					<span class="text-zinc-300">Booked / 已客滿</span>
				</div>
				<div class="flex items-center justify-center gap-3">
					<span class="px-2.5 py-0.5 text-[8px] md:text-[9px] text-sky-300 bg-sky-500/20 border border-sky-500/30 rounded font-medium tracking-widest">台北</span>
					<span class="text-zinc-300">Location / 所在縣市</span>
				</div>
			</div>
		</div>
	</div>

	<!-- 預約表單區塊 -->
	<div class="max-w-4xl mx-auto mt-16 mb-32 animate-fade-in px-4 md:px-0">
		<div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 backdrop-blur-md p-8 md:p-12 shadow-[0_0_50px_rgba(0,0,0,0.6)]">
			<h3 class="brand-font text-white text-base md:text-lg tracking-[0.2em] uppercase font-light text-center mb-2">Book a Session / 填寫預約表單</h3>
			<div class="text-[10px] text-zinc-500 tracking-widest text-center mb-8 leading-relaxed">
				<p class="uppercase mb-1">Please refer to the calendar above for availability / <a href="#booking-section" class="text-amber-300 hover:text-amber-200 transition-colors underline font-medium booking-scroll-btn">請參考上方月曆空檔</a></p>
				<p>填寫後請靜待 Yang 與您聯絡，有任何問題都歡迎透過 <a href="https://www.instagram.com/yang._.photo/" target="_blank" class="text-amber-300 hover:text-amber-200 transition-colors underline font-medium">IG 聯繫</a></p>
			</div>
			
			<form id="booking-form" class="space-y-6">
				<!-- 姓名 -->
				<div class="flex flex-col gap-2">
					<label class="text-[10px] text-zinc-400 tracking-widest uppercase font-bold" for="form-name">Name / 稱呼 <span class="text-amber-500">*</span></label>
					<input type="text" id="form-name" required placeholder="您的稱呼或姓名" class="bg-zinc-950/60 border border-zinc-800 rounded-lg px-4 py-3 text-xs text-white focus:outline-none focus:border-amber-500/50 transition-colors duration-300 placeholder:text-zinc-700" />
				</div>
				
				<!-- 聯絡方式 (LINE / IG / 電話擇一) -->
				<div class="flex flex-col gap-2">
					<label class="text-[10px] text-zinc-400 tracking-widest uppercase font-bold">Contact / 聯絡管道 (LINE / IG / 手機請至少填寫一項) <span class="text-amber-500">*</span></label>
					<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
						<input type="text" id="form-line" placeholder="LINE ID (選填)" class="bg-zinc-950/60 border border-zinc-800 rounded-lg px-4 py-3 text-xs text-white focus:outline-none focus:border-amber-500/50 transition-colors duration-300 placeholder:text-zinc-700" />
						<input type="text" id="form-ig" placeholder="Instagram 帳號 (選填)" class="bg-zinc-950/60 border border-zinc-800 rounded-lg px-4 py-3 text-xs text-white focus:outline-none focus:border-amber-500/50 transition-colors duration-300 placeholder:text-zinc-700" />
						<input type="text" id="form-phone" placeholder="手機號碼 (選填)" class="bg-zinc-950/60 border border-zinc-800 rounded-lg px-4 py-3 text-xs text-white focus:outline-none focus:border-amber-500/50 transition-colors duration-300 placeholder:text-zinc-700" />
					</div>
				</div>
				
				<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
					<!-- Email -->
					<div class="flex flex-col gap-2">
						<label class="text-[10px] text-zinc-400 tracking-widest uppercase font-bold" for="form-email">Email / 電子信箱 (選填)</label>
						<input type="email" id="form-email" placeholder="your.name@example.com (選填)" class="bg-zinc-950/60 border border-zinc-800 rounded-lg px-4 py-3 text-xs text-white focus:outline-none focus:border-amber-500/50 transition-colors duration-300 placeholder:text-zinc-700" />
					</div>
					
					<!-- 拍攝方案 -->
					<div class="flex flex-col gap-2">
						<label class="text-[10px] text-zinc-400 tracking-widest uppercase font-bold" for="form-service">Service / 預約方案 <span class="text-amber-500">*</span></label>
						<select id="form-service" required class="bg-zinc-950/60 border border-zinc-800 rounded-lg px-4 py-3 text-xs text-zinc-400 focus:outline-none focus:border-amber-500/50 transition-colors duration-300 cursor-pointer">
							<option value="" disabled selected>請選擇您想預約的項目</option>
							<option value="婚禮紀錄">Weddings / 婚禮紀錄</option>
							<option value="個人寫真">Portraits / 個人寫真</option>
							<option value="情侶寫真">Couples / 情侶寫真</option>
							<option value="登記寫真">Registration / 登記寫真</option>
							<option value="活動紀錄">Events / 活動紀錄</option>
							<option value="商業攝影">Product / 商業攝影</option>
							<option value="客製化方案">Customized / 客製化方案</option>
						</select>
					</div>
				</div>
				
				<!-- 動態日期時段容器 (預設顯示一列，可點擊新增多個備選時間) -->
				<div id="date-time-container" class="space-y-4">
					<div class="date-time-row grid grid-cols-1 md:grid-cols-2 gap-6 p-4 rounded-xl border border-zinc-800/40 bg-zinc-950/20 relative group">
						<!-- 預約日期 -->
						<div class="flex flex-col gap-2">
							<label class="text-[10px] text-zinc-400 tracking-widest uppercase font-bold">Date / 拍攝日期 (選填 / 無硬性要求可留空)</label>
							<input type="date" name="row-date" class="bg-zinc-950/60 border border-zinc-800 rounded-lg px-4 py-3 text-xs text-zinc-400 focus:outline-none focus:border-amber-500/50 transition-colors duration-300 cursor-pointer" />
						</div>
						
						<!-- 預約時段 -->
						<div class="flex flex-col gap-2 relative pr-8">
							<label class="text-[10px] text-zinc-400 tracking-widest uppercase font-bold">Time / 拍攝時段 (可複選) <span class="text-amber-500">*</span></label>
							<div class="grid grid-cols-3 gap-3">
								<label class="flex items-center justify-center gap-2 bg-zinc-950/60 border border-zinc-800 rounded-lg py-3 text-[10px] text-zinc-400 cursor-pointer select-none hover:border-zinc-750 transition-all duration-300 has-[:checked]:border-amber-500/60 has-[:checked]:text-amber-200">
									<input type="checkbox" name="row-time-morning" value="早上" class="hidden" />
									<span>早上 AM</span>
								</label>
								<label class="flex items-center justify-center gap-2 bg-zinc-950/60 border border-zinc-800 rounded-lg py-3 text-[10px] text-zinc-400 cursor-pointer select-none hover:border-zinc-750 transition-all duration-300 has-[:checked]:border-amber-500/60 has-[:checked]:text-amber-200">
									<input type="checkbox" name="row-time-afternoon" value="下午" class="hidden" />
									<span>下午 PM</span>
								</label>
								<label class="flex items-center justify-center gap-2 bg-zinc-950/60 border border-zinc-800 rounded-lg py-3 text-[10px] text-zinc-400 cursor-pointer select-none hover:border-zinc-750 transition-all duration-300 has-[:checked]:border-amber-500/60 has-[:checked]:text-amber-200">
									<input type="checkbox" name="row-time-evening" value="晚上" class="hidden" />
									<span>晚上 EVE</span>
								</label>
							</div>
						</div>
					</div>
				</div>
				
				<!-- 新增日期按鈕 -->
				<div class="flex justify-start">
					<button type="button" id="add-date-btn" class="flex items-center gap-2 text-[10px] text-amber-300 hover:text-amber-200 transition-colors duration-300 cursor-pointer">
						<span class="inline-flex items-center justify-center w-4 h-4 rounded-full border border-amber-500/50 text-[10px] font-bold">+</span>
						<span>Add Alternative Date / 新增備選日期時段</span>
					</button>
				</div>
				
				<!-- 需求描述 -->
				<div class="flex flex-col gap-2">
					<label class="text-[10px] text-zinc-400 tracking-widest uppercase font-bold" for="form-message">Details / 需求說明</label>
					<textarea id="form-message" rows="4" placeholder="請描述您的拍攝需求、理想地點，或任何想問的事項" class="bg-zinc-950/60 border border-zinc-800 rounded-lg px-4 py-3 text-xs text-white focus:outline-none focus:border-amber-500/50 transition-colors duration-300 placeholder:text-zinc-750 resize-none"></textarea>
				</div>
				
				<!-- 提交按鈕與狀態 -->
				<div class="pt-4 flex flex-col items-center">
					<button type="submit" id="form-submit-btn" class="w-full md:w-auto px-12 py-4 bg-white/5 border border-white/10 text-white text-[10px] tracking-[0.3em] uppercase hover:bg-white hover:text-black hover:border-white transition-all duration-500 rounded-full font-bold cursor-pointer">
						Send Request / 送出預約諮詢
					</button>
					<p id="form-status-msg" class="text-[10px] mt-4 tracking-widest uppercase hidden"></p>
				</div>
			</form>
		</div>
	</div>

	<!-- 預約成功彈窗 Modal -->
	<div id="success-modal" class="fixed inset-0 bg-[#000000]/80 z-[100] hidden opacity-0 transition-opacity duration-500 flex items-center justify-center p-4">
		<div class="max-w-md w-full bg-zinc-900 border border-zinc-800 rounded-2xl p-8 text-center shadow-2xl scale-95 transition-transform duration-500">
			<span class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-amber-400/10 text-amber-300 text-xl font-bold mb-4">✓</span>
			<h3 class="brand-font text-white text-base tracking-[0.2em] uppercase font-light mb-2">Request Sent / 預約已送出</h3>
			<p class="text-zinc-400 text-xs font-light leading-relaxed mb-6">
				我們已收到您的拍攝預約諮詢！<br />將會儘快透過 LINE 或 Email 與您取得聯繫，謝謝您。
			</p>
			<button id="close-success-btn" class="px-8 py-3 bg-white text-black text-[9px] tracking-[0.3em] uppercase hover:bg-zinc-200 transition-colors duration-300 rounded-full font-bold cursor-pointer">
				OK
			</button>
		</div>
	</div>

	<style>
		@keyframes fadeIn {
			from { opacity: 0; transform: translateY(20px); }
			to { opacity: 1; transform: translateY(0); }
		}
		.animate-fade-in {
			animation: fadeIn 1.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
		}
	</style>

	<script>
		// 信箱複製功能 (採用 Class 遍歷與 Clipboard API 雙保險，防範 Astro SPA 換頁元素 ID 衝突)
		const initEmailCopy = () => {
			const emailBtns = document.querySelectorAll('.send-email-btn');
			emailBtns.forEach(btn => {
				if (btn.getAttribute('data-bound')) return;
				btn.setAttribute('data-bound', 'true');

				const showToast = (message: string) => {
					const existing = document.getElementById('email-toast');
					if (existing) existing.remove();

					const toast = document.createElement('div');
					toast.id = 'email-toast';
					toast.className = 'fixed bottom-10 left-1/2 -translate-x-1/2 z-[200] bg-zinc-950 border border-amber-500/40 text-amber-200 text-[10px] tracking-widest uppercase px-6 py-3 rounded-full shadow-[0_0_30px_rgba(245,158,11,0.2)] opacity-0 transition-opacity duration-300 pointer-events-none font-light';
					toast.textContent = message;
					
					document.body.appendChild(toast);
					
					requestAnimationFrame(() => {
						toast.classList.add('opacity-100');
					});
					
					setTimeout(() => {
						toast.classList.remove('opacity-100');
						setTimeout(() => toast.remove(), 300);
					}, 3500);
				};

				btn.addEventListener('click', async () => {
					const email = btn.getAttribute('data-email');
					if (!email) return;

					let successful = false;
					
					// 優先使用現代 Clipboard API
					if (navigator.clipboard && navigator.clipboard.writeText) {
						try {
							await navigator.clipboard.writeText(email);
							successful = true;
						} catch (err) {
							console.warn("Clipboard API 寫入失敗，使用備用 TextArea 方法", err);
						}
					}

					// 備用方法：傳統隱藏 textarea 模擬複製
					if (!successful) {
						try {
							const textArea = document.createElement("textarea");
							textArea.value = email;
							textArea.style.position = "fixed";
							textArea.style.top = "-9999px";
							textArea.style.left = "-9999px";
							document.body.appendChild(textArea);
							textArea.select();
							successful = document.execCommand('copy');
							document.body.removeChild(textArea);
						} catch (err) {}
					}
					
					if (successful) {
						showToast(`Email Copied / 已複製信箱至剪貼簿`);
					}

					setTimeout(() => {
						window.location.href = `mailto:${email}`;
					}, 100);
				});
			});
		};

		// 預約月曆渲染功能
		const initCalendar = () => {
			const calendarDays = document.getElementById('calendar-days');
			const calendarTitle = document.getElementById('calendar-title');
			const prevBtn = document.getElementById('prev-month');
			const nextBtn = document.getElementById('next-month');
			if (!calendarDays || !calendarTitle) return;

			const bookingData = JSON.parse(calendarDays.dataset.booking || '{}');
			
			let currentDate = new Date();
			let currentYear = currentDate.getFullYear();
			let currentMonth = currentDate.getMonth();

			// 方案 B：動態計算並整併當月外縣市連續行程公告
			const updateAnnouncements = () => {
				const container = document.getElementById('location-announcements');
				if (!container) return;

				container.innerHTML = '';
				const announcements = [];
				let startDay = null;
				let currentLoc = null;

				const totalDays = new Date(currentYear, currentMonth + 1, 0).getDate();

				for (let day = 1; day <= totalDays; day++) {
					const formattedMonth = String(currentMonth + 1).padStart(2, '0');
					const formattedDay = String(day).padStart(2, '0');
					const dateStr = `${currentYear}-${formattedMonth}-${formattedDay}`;
					
					const loc = (bookingData[dateStr] && bookingData[dateStr].location) || "";
					const hasForeignLoc = loc && loc !== "新竹";

					if (hasForeignLoc) {
						if (currentLoc === loc) {
							// 連續同個地點，繼續合併
						} else {
							// 遇到新的地點，結算上個
							if (startDay !== null) {
								announcements.push({
									start: startDay,
									end: day - 1,
									location: currentLoc
								});
							}
							startDay = day;
							currentLoc = loc;
						}
					} else {
						// 沒有外縣市地點，結算上個
						if (startDay !== null) {
							announcements.push({
								start: startDay,
								end: day - 1,
								location: currentLoc
							});
							startDay = null;
							currentLoc = null;
						}
					}
				}

				if (startDay !== null) {
					announcements.push({
						start: startDay,
						end: totalDays,
						location: currentLoc
					});
				}

				if (announcements.length > 0) {
					container.classList.remove('hidden');
					
					// 標題
					const title = document.createElement('div');
					title.className = 'font-bold flex items-center gap-2 mb-1 text-[10px] md:text-xs text-sky-300';
					title.innerHTML = '<span>✈️</span> 外縣市行程公告 / TRAVEL SCHEDULE';
					container.appendChild(title);

					announcements.forEach(ann => {
						const item = document.createElement('div');
						item.className = 'font-light flex items-center justify-between text-[9px] md:text-xs py-0.5 border-b border-sky-500/5 last:border-0';
						
						const dateSpan = document.createElement('span');
						if (ann.start === ann.end) {
							dateSpan.textContent = `${currentMonth + 1}月${ann.start}日`;
						} else {
							dateSpan.textContent = `${currentMonth + 1}月${ann.start}日 – ${currentMonth + 1}月${ann.end}日`;
						}

						const locSpan = document.createElement('span');
						locSpan.className = 'px-2 py-0.5 bg-sky-500/20 border border-sky-500/30 rounded text-[8px] md:text-[9.5px] font-semibold text-sky-200';
						locSpan.textContent = ann.location;

						item.appendChild(dateSpan);
						item.appendChild(locSpan);
						container.appendChild(item);
					});
				} else {
					container.classList.add('hidden');
				}
			};

			const render = () => {
				calendarDays.innerHTML = '';
				
				const firstDayIndex = new Date(currentYear, currentMonth, 1).getDay();
				const totalDays = new Date(currentYear, currentMonth + 1, 0).getDate();
				
				const monthNames = [
					"1月", "2月", "3月", "4月", "5月", "6月",
					"7月", "8月", "9月", "10月", "11月", "12月"
				];
				calendarTitle.textContent = `${currentYear}年 ${monthNames[currentMonth]}`;

				// 渲染上月尾巴空白格
				for (let i = 0; i < firstDayIndex; i++) {
					const emptyCell = document.createElement('div');
					emptyCell.className = 'aspect-square bg-zinc-950/20 rounded-lg';
					calendarDays.appendChild(emptyCell);
				}

				// 渲染日期格子
				for (let day = 1; day <= totalDays; day++) {
					const cell = document.createElement('div');
					
					// 比對當天日期，判定是否為「今天」
					const today = new Date();
					const isToday = day === today.getDate() && currentMonth === today.getMonth() && currentYear === today.getFullYear();
					
					if (isToday) {
						// 今天高亮：金色底色、2px 金色邊框
						cell.className = 'min-h-[90px] md:min-h-[120px] bg-amber-500/10 border-2 border-amber-500/80 rounded-xl flex flex-col p-1.5 md:p-3 hover:border-amber-400 transition-colors duration-300 relative group';
					} else {
						// 普通日子
						cell.className = 'min-h-[90px] md:min-h-[120px] bg-zinc-900/50 border border-zinc-800/50 rounded-xl flex flex-col p-1.5 md:p-3 hover:border-zinc-700 transition-colors duration-300 relative group';
					}
					
					const dayNum = document.createElement('span');
					if (isToday) {
						dayNum.className = 'block text-center md:text-left text-[11px] md:text-[12px] text-amber-300 font-bold';
					} else {
						dayNum.className = 'block text-center md:text-left text-[11px] md:text-[12px] text-zinc-300 font-medium';
					}
					dayNum.textContent = day;
					cell.appendChild(dayNum);

					const formattedMonth = String(currentMonth + 1).padStart(2, '0');
					const formattedDay = String(day).padStart(2, '0');
					const dateStr = `${currentYear}-${formattedMonth}-${formattedDay}`;
					
					// 判定是否為週末 (週日 0, 週六 6)
					const dateObj = new Date(currentYear, currentMonth, day);
					const dayOfWeek = dateObj.getDay();
					const isWeekend = dayOfWeek === 0 || dayOfWeek === 6;
					
					// 主要假日接案：平日預設客滿/不開放 (true)，假日預設有空 (false)
					const defaultStatus = isWeekend
						? { morning: false, afternoon: false, evening: false, location: "" }
						: { morning: true, afternoon: true, evening: true, location: "" };
					
					// 合併 JSON 檔案中的自訂覆蓋設定
					const status = {
						...defaultStatus,
						...(bookingData[dateStr] || {})
					};
					
					// 預設 Location 為新竹
					const displayLocation = status.location || "新竹";
					const isDefaultLoc = displayLocation === "新竹";
					
					// 桌機版地點標籤 (手機端隱藏，桌機端右上角顯現，防範行動版擁擠)
					const locBadge = document.createElement('span');
					if (isDefaultLoc) {
						const isLight = document.documentElement.getAttribute('data-theme') === 'light';
						if (isLight) {
							locBadge.className = 'hidden md:block md:absolute md:top-2 md:right-2 text-[10px] text-zinc-500 bg-white border border-zinc-200 px-1 py-0.5 rounded font-light tracking-widest pointer-events-none whitespace-nowrap';
						} else {
							locBadge.className = 'hidden md:block md:absolute md:top-2 md:right-2 text-[10px] text-zinc-500 bg-zinc-900/60 border border-zinc-900/20 px-1 py-0.5 rounded font-light tracking-widest pointer-events-none whitespace-nowrap';
						}
					} else {
						locBadge.className = 'hidden md:block md:absolute md:top-2 md:right-2 text-[10px] text-sky-300 bg-sky-500/20 border border-sky-500/30 px-1 py-0.5 rounded font-medium tracking-widest pointer-events-none whitespace-nowrap';
					}
					locBadge.textContent = displayLocation;
					cell.appendChild(locBadge);
					
					// 判定是否有備註註記 (Note)
					let hoverTitle = `當日地點: ${displayLocation}`;
					if (status.note) {
						hoverTitle += ` | 備註: ${status.note}`;
						
						// 在右側放置一個極低調的灰點代表有備忘
						const noteIcon = document.createElement('span');
						noteIcon.className = 'absolute bottom-1 md:bottom-2 right-2 text-[6px] md:text-[7px] text-zinc-600 font-light pointer-events-none';
						noteIcon.textContent = '●';
						cell.appendChild(noteIcon);
					}
					cell.title = hoverTitle;
					
					const slotContainer = document.createElement('div');
					// 永遠為垂直堆疊且橫向撐滿，手機端與桌機端一致
					slotContainer.className = 'flex flex-col gap-0.5 md:gap-1 mt-1 md:mt-2 w-full';

					const slots = [
						{ key: 'morning', text: '早上', label: '上午 AM' },
						{ key: 'afternoon', text: '下午', label: '下午 PM' },
						{ key: 'evening', text: '晚上', label: '晚上 EVE' }
					];

					slots.forEach(slot => {
						const badge = document.createElement('span');
						const isBooked = status[slot.key] === true || status[slot.key] === "客滿" || status[slot.key] === "不開放";
						
						if (isBooked) {
							// 客滿：調暗且 line-through 的小圓角長條
							badge.className = 'w-full text-center text-[7px] md:text-[10.5px] text-zinc-500 bg-zinc-900/60 border border-zinc-800/40 py-0.5 md:py-1 rounded cursor-help line-through opacity-40 md:opacity-50 transition-colors duration-300';
							badge.title = `${slot.label}: 已預約 / 不開放`;
						} else {
							// 有空：帶金色邊框與底色的小圓角長條
							badge.className = 'w-full text-center text-[7px] md:text-[10.5px] text-amber-300 bg-amber-400/10 border border-amber-500/30 py-0.5 md:py-1 rounded cursor-help transition-all duration-300 hover:bg-amber-400/20';
							badge.title = `${slot.label}: 可預約`;
						}
						badge.textContent = slot.text;
						slotContainer.appendChild(badge);
					});

					cell.appendChild(slotContainer);
					calendarDays.appendChild(cell);
				}

				// 方案 B：更新外縣市公告欄
				updateAnnouncements();
			};

			prevBtn?.addEventListener('click', () => {
				currentMonth--;
				if (currentMonth < 0) {
					currentMonth = 11;
					currentYear--;
				}
				render();
			});

			nextBtn?.addEventListener('click', () => {
				currentMonth++;
				if (currentMonth > 11) {
					currentMonth = 0;
					currentYear++;
				}
				render();
			});

			render();
		};

		// 3. 預約表單處理功能
		const initBookingForm = () => {
			const form = document.getElementById('booking-form') as HTMLFormElement;
			const submitBtn = document.getElementById('form-submit-btn');
			const statusMsg = document.getElementById('form-status-msg');
			const successModal = document.getElementById('success-modal');
			const closeModalBtn = document.getElementById('close-success-btn');
			const addDateBtn = document.getElementById('add-date-btn');
			const dateTimeContainer = document.getElementById('date-time-container');
			
			if (!form || !submitBtn) return;
			
			// 日期輸入框輔助器：點選輸入框任何地方即可彈出日曆
			const bindDatePickerHelper = (input: HTMLInputElement) => {
				if (!input) return;
				const handler = () => {
					try {
						input.showPicker();
					} catch (e) {}
				};
				input.addEventListener('focus', handler);
				input.addEventListener('click', handler);
			};

			// 對初始第一列日期輸入框進行綁定
			const initialDateInput = form.querySelector('input[name="row-date"]') as HTMLInputElement;
			if (initialDateInput) bindDatePickerHelper(initialDateInput);

			// 預約諮詢按鈕與方案連動＋平滑滾動到月曆區
			const inquiryBtns = document.querySelectorAll('.inquiry-btn');
			const serviceSelect = document.getElementById('form-service') as HTMLSelectElement;
			inquiryBtns.forEach(btn => {
				btn.addEventListener('click', (e) => {
					e.preventDefault();
					const targetService = btn.getAttribute('data-service');
					if (serviceSelect && targetService) {
						serviceSelect.value = targetService;
						serviceSelect.classList.remove('text-zinc-400');
						serviceSelect.classList.add('text-white');
					}
					
					const bookingForm = document.getElementById('booking-form');
					if (bookingForm) {
						bookingForm.scrollIntoView({ behavior: 'smooth', block: 'start' });
					}
				});
			});

			// 點擊「請參考上方月曆空檔」平滑滾動至月曆區
			const bookingScrollBtns = document.querySelectorAll('.booking-scroll-btn');
			bookingScrollBtns.forEach(btn => {
				btn.addEventListener('click', (e) => {
					e.preventDefault();
					const bookingSection = document.getElementById('booking-section');
					if (bookingSection) {
						bookingSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
					}
				});
			});

			// 新增備選日期時段
			addDateBtn?.addEventListener('click', () => {
				if (!dateTimeContainer) return;
				const rowCount = dateTimeContainer.querySelectorAll('.date-time-row').length;
				if (rowCount >= 5) {
					alert('最多可提供 5 個備選日期時段！');
					return;
				}
				
				const newRow = document.createElement('div');
				newRow.className = 'date-time-row grid grid-cols-1 md:grid-cols-2 gap-6 p-4 rounded-xl border border-zinc-800/45 bg-zinc-950/20 relative group';
				
				newRow.innerHTML = `
					<!-- 預約日期 -->
					<div class="flex flex-col gap-2">
						<label class="text-[10px] text-zinc-400 tracking-widest uppercase font-bold">Date / 備選拍攝日期 (選填)</label>
						<input type="date" name="row-date" class="bg-zinc-950/60 border border-zinc-800 rounded-lg px-4 py-3 text-xs text-zinc-400 focus:outline-none focus:border-amber-500/50 transition-colors duration-300 cursor-pointer" />
					</div>
					
					<!-- 預約時段 -->
					<div class="flex flex-col gap-2 relative pr-8">
						<label class="text-[10px] text-zinc-400 tracking-widest uppercase font-bold">Time / 拍攝時段 (可複選) <span class="text-amber-500">*</span></label>
						<div class="grid grid-cols-3 gap-3">
							<label class="flex items-center justify-center gap-2 bg-zinc-950/60 border border-zinc-800 rounded-lg py-3 text-[10px] text-zinc-400 cursor-pointer select-none hover:border-zinc-750 transition-all duration-300 has-[:checked]:border-amber-500/60 has-[:checked]:text-amber-200">
								<input type="checkbox" name="row-time-morning" value="早上" class="hidden" />
								<span>早上 AM</span>
							</label>
							<label class="flex items-center justify-center gap-2 bg-zinc-950/60 border border-zinc-800 rounded-lg py-3 text-[10px] text-zinc-400 cursor-pointer select-none hover:border-zinc-750 transition-all duration-300 has-[:checked]:border-amber-500/60 has-[:checked]:text-amber-200">
								<input type="checkbox" name="row-time-afternoon" value="下午" class="hidden" />
								<span>下午 PM</span>
							</label>
							<label class="flex items-center justify-center gap-2 bg-zinc-950/60 border border-zinc-800 rounded-lg py-3 text-[10px] text-zinc-400 cursor-pointer select-none hover:border-zinc-750 transition-all duration-300 has-[:checked]:border-amber-500/60 has-[:checked]:text-amber-200">
								<input type="checkbox" name="row-time-evening" value="晚上" class="hidden" />
								<span>晚上 EVE</span>
							</label>
						</div>
						
						<!-- 刪除按鈕 -->
						<button type="button" class="remove-date-btn absolute right-0 top-9 w-6 h-6 rounded-full border border-zinc-800 hover:border-red-500/50 hover:text-red-400 transition-colors duration-300 text-[10px] flex items-center justify-center cursor-pointer">✕</button>
					</div>
				`;
				
				dateTimeContainer.appendChild(newRow);
				
				// 對新生成的日期輸入框進行日曆彈出綁定
				const newDateInput = newRow.querySelector('input[name="row-date"]') as HTMLInputElement;
				if (newDateInput) bindDatePickerHelper(newDateInput);
				
				// 綁定刪除事件
				newRow.querySelector('.remove-date-btn')?.addEventListener('click', () => {
					newRow.remove();
				});
			});
			
			// 關閉 Modal
			closeModalBtn?.addEventListener('click', () => {
				if (!successModal) return;
				successModal.classList.remove('opacity-100');
				successModal.querySelector('div')?.classList.add('scale-95');
				setTimeout(() => {
					successModal.classList.add('hidden');
				}, 500);
			});

			form.addEventListener('submit', async (e) => {
				e.preventDefault();

				// 驗證三種聯絡管道 (LINE / IG / 手機) 至少填寫一項
				const lineVal = (document.getElementById('form-line') as HTMLInputElement).value.trim();
				const igVal = (document.getElementById('form-ig') as HTMLInputElement).value.trim();
				const phoneVal = (document.getElementById('form-phone') as HTMLInputElement).value.trim();
				
				if (!lineVal && !igVal && !phoneVal) {
					alert('請至少填寫一種聯絡方式（LINE ID、Instagram 或手機號碼），方便我們後續與您聯繫！');
					return;
				}

				// 打包有填寫的聯絡管道資訊
				const contactParts: string[] = [];
				if (lineVal) contactParts.push(`LINE: ${lineVal}`);
				if (igVal) contactParts.push(`IG: ${igVal}`);
				if (phoneVal) contactParts.push(`Phone: ${phoneVal}`);
				const finalContact = contactParts.join(', ');
				
				// 收集所有日期與時段列
				const rows = form.querySelectorAll('.date-time-row');
				const bookingDates: string[] = [];
				const bookingTimes: string[] = [];
				let hasTimeSelected = true;

				rows.forEach((row) => {
					const dateInput = row.querySelector('input[name="row-date"]') as HTMLInputElement;
					const dateVal = dateInput.value || "無硬性要求";
					
					// 抓取時段 (可能是第一列或新增列)
					const morningChecked = (row.querySelector('input[name="row-time-morning"]') || row.querySelector('input[name="form-time"][value="早上"]')) as HTMLInputElement;
					const afternoonChecked = (row.querySelector('input[name="row-time-afternoon"]') || row.querySelector('input[name="form-time"][value="下午"]')) as HTMLInputElement;
					const eveningChecked = (row.querySelector('input[name="row-time-evening"]') || row.querySelector('input[name="form-time"][value="晚上"]')) as HTMLInputElement;
					
					const times: string[] = [];
					if (morningChecked?.checked) times.push("早上");
					if (afternoonChecked?.checked) times.push("下午");
					if (eveningChecked?.checked) times.push("晚上");
					
					if (times.length === 0) {
						hasTimeSelected = false;
					}
					
					bookingDates.push(dateVal);
					bookingTimes.push(`${dateVal} (${times.join(', ')})`);
				});
				
				if (!hasTimeSelected) {
					alert('每一組日期皆須勾選至少一個時段（早上/下午/晚上）！');
					return;
				}
				
				// 整理表單數據
				const formData = {
					name: (document.getElementById('form-name') as HTMLInputElement).value,
					contact: finalContact,
					email: (document.getElementById('form-email') as HTMLInputElement).value,
					service: (document.getElementById('form-service') as HTMLSelectElement).value,
					date: bookingDates.join(' | '),
					time: bookingTimes.join(' | '),
					message: (document.getElementById('form-message') as HTMLTextAreaElement).value
				};
				
				// 狀態列改為「傳送中...」
				if (statusMsg) {
					statusMsg.className = 'text-[10px] mt-4 tracking-widest uppercase text-amber-300 animate-pulse';
					statusMsg.textContent = 'Submitting... / 傳送中...';
					statusMsg.classList.remove('hidden');
				}
				submitBtn.setAttribute('disabled', 'true');
				
				// ==========================================
				// 🛠️ 資料庫串接 DEMO 設定區 🛠️
				// ==========================================
				// 預設為 "demo" 模式 (直接模擬傳送成功)。若要使用試算表，請改為 "sheets"；使用 Supabase 請改為 "supabase"
				const activeDatabase: "demo" | "sheets" | "supabase" = "sheets"; 
				
				const GOOGLE_SHEETS_URL = "https://script.google.com/macros/s/AKfycbwr64qsLJgqajMP_xwu5Z17uJmZAp21guLW-I_0dTH_3LKb9IGbIuiZ2X2w4Or7TLM4CA/exec";
				const SUPABASE_URL = "您的_SUPABASE_PROJECT_URL";
				const SUPABASE_ANON_KEY = "您的_SUPABASE_PUBLIC_ANON_KEY";
				
				try {
					let success = false;
					
					if (activeDatabase === "demo") {
						// 【模擬 Demo】延遲 1.5 秒模擬寫入資料庫
						await new Promise(resolve => setTimeout(resolve, 1500));
						console.log("【Demo 模式】預約資料寫入成功：", formData);
						success = true;
						
					} else if (activeDatabase === "sheets") {
						// 【方案一：Google 試算表 (GAS)】
						await fetch(GOOGLE_SHEETS_URL, {
							method: 'POST',
							mode: 'no-cors',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify(formData)
						});
						success = true;
						
					} else if (activeDatabase === "supabase") {
						// 【方案二：Supabase REST API】
						const response = await fetch(`${SUPABASE_URL}/rest/v1/bookings`, {
							method: 'POST',
							headers: {
								'Content-Type': 'application/json',
								'apikey': SUPABASE_ANON_KEY,
								'Authorization': `Bearer ${SUPABASE_ANON_KEY}`,
								'Prefer': 'return=minimal'
							},
							body: JSON.stringify(formData)
						});
						if (response.ok) success = true;
						else throw new Error("Supabase 寫入失敗");
					}
					
					if (success) {
						// 表單重設
						form.reset();
						
						// 清空動態新增的備選日期列 (只保留第一列)
						if (dateTimeContainer) {
							const extraRows = dateTimeContainer.querySelectorAll('.date-time-row');
							extraRows.forEach((row, idx) => {
								if (idx > 0) row.remove();
							});
						}
						
						if (statusMsg) statusMsg.classList.add('hidden');
						
						// 顯示成功 Modal
						if (successModal) {
							successModal.classList.remove('hidden');
							requestAnimationFrame(() => {
								successModal.classList.add('opacity-100');
								successModal.querySelector('div')?.classList.remove('scale-95');
							});
						}
					}
				} catch (err) {
					console.error("預約提交失敗：", err);
					if (statusMsg) {
						statusMsg.className = 'text-[10px] mt-4 tracking-widest uppercase text-red-500 font-bold';
						statusMsg.textContent = 'Error! Please try again later / 傳送失敗，請稍後再試！';
					}
				} finally {
					submitBtn.removeAttribute('disabled');
				}
			});
		};

		document.addEventListener('astro:page-load', () => {
			initEmailCopy();
			initCalendar();
			initBookingForm();
		});
	</script>
</Layout>
