---
import Layout from '../layouts/Layout.astro';
import bookingData from '../data/booking.json';
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<Layout title="Booking & Availability / 行事曆預約狀況與表單 | Yang Photography" description="線上查詢 Yang Photography 當月拍攝檔期與行程。平日與週末提供彈性預約，可直接線上送出拍攝諮詢表單。">
	<!-- 獨立預約頁頂部 Hero 區塊 -->
	<section class="pt-8 pb-12 text-center animate-fade-in">
		<h1 class="brand-font text-white text-3xl md:text-5xl tracking-[0.25em] uppercase font-light mb-4">
			Yang Photo.
		</h1>
		<p class="text-zinc-500 text-xs md:text-sm tracking-[0.3em] uppercase mb-2">
			Booking & Inquiry / 拍攝預約諮詢
		</p>
		<div class="h-px w-12 bg-zinc-800 mx-auto mt-6"></div>
	</section>

	<!-- 預約月曆區塊 -->
	<div id="booking-section" class="pb-16 animate-fade-in">
		<h2 class="text-[10px] text-zinc-500 tracking-[0.4em] uppercase mb-12 text-center">— Booking / 預約狀況 —</h2>
		<p class="booking-swipe-hint md:hidden -mt-8 mb-3 mx-auto w-fit text-center text-[9px] tracking-widest text-zinc-500">← 左右滑動查看完整月曆 →</p>
		
		<div class="booking-calendar-scroll -mx-2 overflow-x-auto px-2 pb-3">
		<div class="booking-calendar-wrapper min-w-[640px] max-w-4xl mx-auto rounded-2xl border border-zinc-800 bg-zinc-900/40 backdrop-blur-md p-6 md:p-8 shadow-[0_0_50px_rgba(0,0,0,0.6)]">
			<!-- 月曆頂部導覽 -->
			<div class="flex items-center justify-between mb-8 px-2">
				<button id="prev-month" aria-label="Previous month" class="min-h-11 shrink-0 px-2 flex items-center text-zinc-500 hover:text-white text-[10px] tracking-widest uppercase transition-colors duration-300 cursor-pointer">← Prev / 上月</button>
				<h3 id="calendar-title" class="brand-font text-white text-sm md:text-base tracking-[0.2em] uppercase font-light">July 2026</h3>
				<button id="next-month" aria-label="Next month" class="min-h-11 shrink-0 px-2 flex items-center text-zinc-500 hover:text-white text-[10px] tracking-widest uppercase transition-colors duration-300 cursor-pointer">Next / 下月 →</button>
			</div>
			
			<!-- 外縣市行程公告欄 (方案 B：自動整併連續日期地點) -->
			<div id="location-announcements" class="mb-6 px-4 py-3 bg-sky-500/10 border border-sky-500/20 text-sky-200 text-[10px] md:text-xs tracking-widest uppercase rounded-xl flex flex-col gap-1.5 hidden">
				<!-- 由 JS 動態填充 -->
			</div>

			<!-- 星期欄 -->
			<div class="grid grid-cols-7 gap-2 text-center text-[9px] tracking-widest text-zinc-400 uppercase mb-4 font-bold">
				<div>Sun</div><div>Mon</div><div>Tue</div><div>Wed</div><div>Thu</div><div>Fri</div><div>Sat</div>
			</div>
			
			<!-- 日子網格 -->
			<div id="calendar-days" class="grid grid-cols-7 gap-2" data-booking={JSON.stringify(bookingData)}>
				<!-- 由 JS 動態填充 -->
			</div>
			
			<!-- 圖例說明 (優化大小與藍色標記) -->
			<div class="grid grid-cols-1 sm:grid-cols-3 gap-6 max-w-2xl mx-auto mt-8 pt-6 border-t border-zinc-900/50 text-[10px] md:text-xs text-zinc-400 tracking-wider">
				<div class="flex items-center justify-center gap-3">
					<span class="px-2.5 py-0.5 text-[8px] md:text-[9px] text-amber-300 bg-amber-400/10 border border-amber-500/30 rounded font-normal">早上</span>
					<span class="text-zinc-300">Available / 可預約</span>
				</div>
				<div class="flex items-center justify-center gap-3">
					<span class="px-2.5 py-0.5 text-[8px] md:text-[9px] text-zinc-500 bg-zinc-900/60 border border-zinc-800/40 rounded line-through opacity-50">下午</span>
					<span class="text-zinc-300">Booked / 已客滿</span>
				</div>
				<div class="flex items-center justify-center gap-3">
					<span class="px-2.5 py-0.5 text-[8px] md:text-[9px] text-sky-300 bg-sky-500/20 border border-sky-500/30 rounded font-medium tracking-widest">台北</span>
					<span class="text-zinc-300">Location / 所在縣市</span>
				</div>
			</div>

			<!-- 貼心提醒 (高情商說詞) -->
			<div class="mt-8 pt-6 border-t border-zinc-950/40 text-center">
				<p class="text-[9.5px] md:text-[10px] text-zinc-500 tracking-widest leading-relaxed font-light">
					💬 貼心提醒：平日（週一至週五）行程具備高度彈性，如有拍攝需求，歡迎直接送出預約表單諮詢協調。<br class="hidden sm:inline" />
					<span class="text-zinc-650 uppercase text-[8.5px] tracking-[0.15em] mt-1 block">Notice: Weekday scheduling is highly flexible. Please feel free to send an inquiry to coordinate your session.</span>
				</p>
			</div>
		</div>
		</div>
	</div>

	<!-- 預約表單區塊 -->
	<div class="max-w-4xl mx-auto mb-32 animate-fade-in px-4 md:px-0">
		<div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 backdrop-blur-md p-8 md:p-12 shadow-[0_0_50px_rgba(0,0,0,0.6)]">
			<h3 class="brand-font text-white text-base md:text-lg tracking-[0.2em] uppercase font-light text-center mb-2">Book a Session / 填寫預約表單</h3>
			<div class="text-[10px] text-zinc-500 tracking-widest text-center mb-8 leading-relaxed">
				<p class="uppercase mb-1">Please refer to the calendar above for availability / <a href="#booking-section" class="text-amber-300 hover:text-amber-200 transition-colors underline font-medium booking-scroll-btn">請參考上方月曆空檔</a></p>
				<p>填寫後請靜待 Yang 與您聯絡，有任何問題都歡迎透過 <a href="https://www.instagram.com/yang._.photo/" target="_blank" class="text-amber-300 hover:text-amber-200 transition-colors underline font-medium">IG 聯繫</a></p>
			</div>
			
			{turnstileSiteKey && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>}
			<form id="booking-form" class="space-y-6">
				<div class="hidden" aria-hidden="true">
					<label for="website">Website</label>
					<input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
				</div>
				{turnstileSiteKey && <div id="turnstile-widget" data-sitekey={turnstileSiteKey}></div>}
				{turnstileSiteKey && <input id="turnstile-token" type="hidden" />}
				<!-- 姓名 -->
				<div class="flex flex-col gap-2">
					<label class="text-[10px] text-zinc-400 tracking-widest uppercase font-bold" for="form-name">Name / 稱呼 <span class="text-amber-500">*</span></label>
					<input type="text" id="form-name" required placeholder="您的稱呼或姓名" class="bg-zinc-950/60 border border-zinc-800 rounded-lg px-4 py-3 text-xs text-white focus:outline-none focus:border-amber-500/50 transition-colors duration-300 placeholder:text-zinc-700" />
				</div>
				
				<!-- 聯絡方式 (LINE / IG / 電話擇一) -->
				<div class="flex flex-col gap-2">
					<label class="text-[10px] text-zinc-400 tracking-widest uppercase font-bold">Contact / 聯絡管道 (LINE / IG / 手機請至少填寫一項) <span class="text-amber-500">*</span></label>
					<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
						<input type="text" id="form-line" aria-label="LINE ID" placeholder="LINE ID (選填)" class="bg-zinc-950/60 border border-zinc-800 rounded-lg px-4 py-3 text-xs text-white focus:outline-none focus:border-amber-500/50 transition-colors duration-300 placeholder:text-zinc-700" />
						<input type="text" id="form-ig" aria-label="Instagram account" placeholder="Instagram 帳號 (選填)" class="bg-zinc-950/60 border border-zinc-800 rounded-lg px-4 py-3 text-xs text-white focus:outline-none focus:border-amber-500/50 transition-colors duration-300 placeholder:text-zinc-700" />
						<input type="text" id="form-phone" aria-label="Phone number" placeholder="手機號碼 (選填)" class="bg-zinc-950/60 border border-zinc-800 rounded-lg px-4 py-3 text-xs text-white focus:outline-none focus:border-amber-500/50 transition-colors duration-300 placeholder:text-zinc-700" />
					</div>
				</div>
				
				<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
					<!-- Email -->
					<div class="flex flex-col gap-2">
						<label class="text-[10px] text-zinc-400 tracking-widest uppercase font-bold" for="form-email">Email / 電子信箱 (選填)</label>
						<input type="email" id="form-email" placeholder="your.name@example.com (選填)" class="bg-zinc-950/60 border border-zinc-800 rounded-lg px-4 py-3 text-xs text-white focus:outline-none focus:border-amber-500/50 transition-colors duration-300 placeholder:text-zinc-700" />
					</div>
					
					<!-- 拍攝方案 -->
					<div class="flex flex-col gap-2">
						<label class="text-[10px] text-zinc-400 tracking-widest uppercase font-bold" for="form-service">Service / 預約方案 <span class="text-amber-500">*</span></label>
						<select id="form-service" required class="bg-zinc-950/60 border border-zinc-800 rounded-lg px-4 py-3 text-xs text-white focus:outline-none focus:border-amber-500/50 transition-colors duration-300 cursor-pointer appearance-none">
							<option value="" disabled selected class="bg-zinc-950">請選擇拍攝方案</option>
							<option value="個人人像" class="bg-zinc-950">Portrait / 個人人像</option>
							<option value="情侶人像" class="bg-zinc-950">Couple / 情侶人像</option>
							<option value="婚禮記錄" class="bg-zinc-950">Wedding / 婚禮記錄</option>
							<option value="旅拍隨筆" class="bg-zinc-950">Travel / 旅拍隨筆</option>
							<option value="登記寫真" class="bg-zinc-950">Registration / 登記寫真</option>
							<option value="商品攝影" class="bg-zinc-950">Product / 商品攝影</option>
							<option value="商業攝影" class="bg-zinc-950">Commercial / 商業攝影</option>
							<option value="活動記錄" class="bg-zinc-950">Event / 活動記錄</option>
							<option value="客製化方案" class="bg-zinc-950">Customized / 客製化方案</option>
						</select>
					</div>
				</div>
				
				<!-- 拍攝日期 (動態追加) -->
				<div class="flex flex-col gap-3">
					<div class="text-[10px] text-zinc-400 tracking-widest uppercase font-bold flex items-center justify-between">
						<span>Preferred Dates / 理想拍攝日期 (可填寫多個候選時段) <span class="text-amber-500">*</span></span>
						<button type="button" id="add-date-row-btn" class="px-3 py-1 bg-amber-500/10 border border-amber-500/30 text-amber-300 hover:bg-amber-500/20 text-[9px] uppercase tracking-wider transition-colors duration-300 rounded cursor-pointer">+ Add Date</button>
					</div>
					
					<div id="booking-dates-container" class="space-y-3">
						<!-- 首個日期選擇列 -->
						<div class="booking-date-row grid grid-cols-1 sm:grid-cols-2 gap-4 p-4 bg-zinc-50 border border-zinc-200 rounded-xl relative shadow-sm">
							<!-- 點選日期 -->
							<div class="flex flex-col gap-2">
								<span class="text-[8px] text-zinc-600 tracking-widest uppercase font-bold">Select Date / 選擇日期</span>
								<input type="date" required aria-label="Preferred date" class="date-picker-input bg-white border border-zinc-200 rounded px-3 py-2 text-xs text-zinc-900 focus:outline-none focus:border-amber-500/60 focus:ring-2 focus:ring-amber-500/10 transition-colors cursor-pointer w-full" />
							</div>
							<!-- 時段多選 -->
							<div class="flex flex-col gap-2">
								<span class="text-[8px] text-zinc-600 tracking-widest uppercase font-bold">Preferred Time / 偏好時段 (可複選)</span>
								<div class="grid grid-cols-3 gap-2">
									<label class="flex items-center justify-center gap-1.5 py-2 border border-zinc-200 bg-white rounded text-[9px] text-zinc-600 hover:border-amber-500/50 transition-all cursor-pointer select-none has-[:checked]:border-amber-500/60 has-[:checked]:text-amber-800 has-[:checked]:bg-amber-50">
										<input type="checkbox" name="time-slot-0" value="morning" class="hidden" />
										<span>早上</span>
									</label>
									<label class="flex items-center justify-center gap-1.5 py-2 border border-zinc-200 bg-white rounded text-[9px] text-zinc-600 hover:border-amber-500/50 transition-all cursor-pointer select-none has-[:checked]:border-amber-500/60 has-[:checked]:text-amber-800 has-[:checked]:bg-amber-50">
										<input type="checkbox" name="time-slot-0" value="afternoon" class="hidden" />
										<span>下午</span>
									</label>
									<label class="flex items-center justify-center gap-1.5 py-2 border border-zinc-200 bg-white rounded text-[9px] text-zinc-600 hover:border-amber-500/50 transition-all cursor-pointer select-none has-[:checked]:border-amber-500/60 has-[:checked]:text-amber-800 has-[:checked]:bg-amber-50">
										<input type="checkbox" name="time-slot-0" value="evening" class="hidden" />
										<span>晚上</span>
									</label>
								</div>
							</div>
						</div>
					</div>
				</div>
				
				<!-- 需求描述 -->
				<div class="flex flex-col gap-2">
					<label class="text-[10px] text-zinc-400 tracking-widest uppercase font-bold" for="form-message">Details / 需求說明</label>
					<textarea id="form-message" rows="4" placeholder="請描述您的拍攝需求、理想地點，或任何想問的事項" class="bg-zinc-950/60 border border-zinc-800 rounded-lg px-4 py-3 text-xs text-white focus:outline-none focus:border-amber-500/50 transition-colors duration-300 placeholder:text-zinc-750 resize-none"></textarea>
				</div>
				
				<!-- 提交按鈕與狀態 -->
				<div class="pt-4 flex flex-col items-center">
					<button type="submit" id="form-submit-btn" class="w-full md:w-auto px-12 py-4 bg-white/5 border border-white/10 text-white text-[10px] tracking-[0.3em] uppercase hover:bg-white hover:text-black hover:border-white transition-all duration-500 rounded-full font-bold cursor-pointer">
						Send Request / 送出預約諮詢
					</button>
					<p id="form-status-msg" class="text-[10px] mt-4 tracking-widest uppercase hidden"></p>
				</div>
			</form>
		</div>
	</div>

	<!-- 預約成功彈窗 Modal -->
	<div id="success-modal" class="fixed inset-0 bg-[#000000]/80 z-[100] hidden opacity-0 transition-opacity duration-500 flex items-center justify-center p-4">
		<div class="max-w-md w-full bg-zinc-900 border border-zinc-800 rounded-2xl p-8 text-center shadow-2xl scale-95 transition-transform duration-500">
			<span class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-amber-400/10 text-amber-300 text-xl font-bold mb-4">✓</span>
			<h3 class="brand-font text-white text-base tracking-[0.2em] uppercase font-light mb-2">Request Sent / 預約已送出</h3>
			<p class="text-zinc-400 text-xs font-light leading-relaxed mb-6">
				我們已收到您的拍攝預約諮詢！<br />將會儘快透過 LINE 或 Email 與您取得聯繫，謝謝您。
			</p>
			<button id="close-success-btn" class="px-8 py-3 bg-white text-black text-[9px] tracking-[0.3em] uppercase hover:bg-zinc-200 transition-colors duration-300 rounded-full font-bold cursor-pointer">
				OK
			</button>
		</div>
	</div>

	<style>
		@keyframes fadeIn {
			from { opacity: 0; transform: translateY(20px); }
			to { opacity: 1; transform: translateY(0); }
		}
		.animate-fade-in {
			animation: fadeIn 1.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
		}

		.booking-calendar-scroll {
			scroll-behavior: smooth;
			scrollbar-width: none;
			-ms-overflow-style: none;
			overscroll-behavior-x: contain;
		}

		.booking-calendar-scroll::-webkit-scrollbar {
			display: none;
		}

		@media (max-width: 767px) {
			.booking-calendar-scroll {
				mask-image: linear-gradient(90deg, transparent, black 18px, black calc(100% - 18px), transparent);
			}

			.booking-swipe-hint {
				padding: 0.45rem 0.8rem;
				border: 1px solid rgba(161, 161, 170, 0.22);
				border-radius: 9999px;
				background: rgba(255, 255, 255, 0.04);
			}
		}
	</style>

	<script>
		// 預約月曆渲染功能
		const initCalendar = () => {
			const calendarDays = document.getElementById('calendar-days');
			const calendarTitle = document.getElementById('calendar-title');
			const prevBtn = document.getElementById('prev-month');
			const nextBtn = document.getElementById('next-month');
			if (!calendarDays || !calendarTitle) return;

			const bookingData = JSON.parse(calendarDays.dataset.booking || '{}');
			
			let currentDate = new Date();
			let currentYear = currentDate.getFullYear();
			let currentMonth = currentDate.getMonth();

			// 方案 B：動態計算並整併當月外縣市連續行程公告
			const updateAnnouncements = () => {
				const container = document.getElementById('location-announcements');
				if (!container) return;

				container.innerHTML = '';
				const announcements = [];
				let startDay = null;
				let currentLoc = null;

				const totalDays = new Date(currentYear, currentMonth + 1, 0).getDate();

				for (let day = 1; day <= totalDays; day++) {
					const formattedMonth = String(currentMonth + 1).padStart(2, '0');
					const formattedDay = String(day).padStart(2, '0');
					const dateStr = `${currentYear}-${formattedMonth}-${formattedDay}`;
					
					const loc = (bookingData[dateStr] && bookingData[dateStr].location) || "";
					const hasForeignLoc = loc && loc !== "新竹" && loc !== "";

					if (hasForeignLoc) {
						if (currentLoc === loc) {
							// 連續同個地點，繼續合併
						} else {
							// 遇到新的地點，結算上個
							if (startDay !== null) {
								announcements.push({
									start: startDay,
									end: day - 1,
									location: currentLoc
								});
							}
							startDay = day;
							currentLoc = loc;
						}
					} else {
						// 沒有外縣市地點，結算上個
						if (startDay !== null) {
							announcements.push({
								start: startDay,
								end: day - 1,
								location: currentLoc
							});
							startDay = null;
							currentLoc = null;
						}
					}
				}

				if (startDay !== null) {
					announcements.push({
						start: startDay,
						end: totalDays,
						location: currentLoc
					});
				}

				if (announcements.length > 0) {
					container.classList.remove('hidden');
					
					// 標題
					const title = document.createElement('div');
					title.className = 'font-bold flex items-center gap-2 mb-1 text-[10px] md:text-xs text-sky-300';
					title.innerHTML = '<span>✈️</span> 外縣市行程公告 / TRAVEL SCHEDULE';
					container.appendChild(title);

					announcements.forEach(ann => {
						const item = document.createElement('div');
						item.className = 'font-light flex items-center justify-between text-[9px] md:text-xs py-0.5 border-b border-sky-500/5 last:border-0';
						
						const dateSpan = document.createElement('span');
						if (ann.start === ann.end) {
							dateSpan.textContent = `${currentMonth + 1}月${ann.start}日`;
						} else {
							dateSpan.textContent = `${currentMonth + 1}月${ann.start}日 – ${currentMonth + 1}月${ann.end}日`;
						}

						const locSpan = document.createElement('span');
						locSpan.className = 'px-2 py-0.5 bg-sky-500/20 border border-sky-500/30 rounded text-[8px] md:text-[9.5px] font-semibold text-sky-200';
						locSpan.textContent = ann.location;

						item.appendChild(dateSpan);
						item.appendChild(locSpan);
						container.appendChild(item);
					});
				} else {
					container.classList.add('hidden');
				}
			};

			const render = () => {
				calendarDays.innerHTML = '';
				
				const firstDayIndex = new Date(currentYear, currentMonth, 1).getDay();
				const totalDays = new Date(currentYear, currentMonth + 1, 0).getDate();
				
				const monthNames = [
					"1月", "2月", "3月", "4月", "5月", "6月",
					"7月", "8月", "9月", "10月", "11月", "12月"
				];
				calendarTitle.textContent = `${currentYear}年 ${monthNames[currentMonth]}`;

				// 渲染上月尾巴空白格
				for (let i = 0; i < firstDayIndex; i++) {
					const emptyCell = document.createElement('div');
					emptyCell.className = 'aspect-square bg-zinc-950/20 rounded-lg';
					calendarDays.appendChild(emptyCell);
				}

				// 渲染日期格子
				for (let day = 1; day <= totalDays; day++) {
					const cell = document.createElement('div');
					
					// 比對當天日期，判定是否為「今天」
					const today = new Date();
					const isToday = day === today.getDate() && currentMonth === today.getMonth() && currentYear === today.getFullYear();
					
					if (isToday) {
						// 今天高亮：金色底色、2px 金色邊框
						cell.className = 'min-h-[90px] md:min-h-[120px] bg-amber-500/10 border-2 border-amber-500/80 rounded-xl flex flex-col p-1.5 md:p-3 hover:border-amber-400 transition-colors duration-300 relative group';
					} else {
						// 普通日子
						cell.className = 'min-h-[90px] md:min-h-[120px] bg-zinc-900/50 border border-zinc-800/50 rounded-xl flex flex-col p-1.5 md:p-3 hover:border-zinc-700 transition-colors duration-300 relative group';
					}
					
					const dayNum = document.createElement('span');
					if (isToday) {
						dayNum.className = 'block text-center md:text-left text-[11px] md:text-[12px] text-amber-300 font-bold';
					} else {
						dayNum.className = 'block text-center md:text-left text-[11px] md:text-[12px] text-zinc-300 font-medium';
					}
					dayNum.textContent = day;
					cell.appendChild(dayNum);

					const formattedMonth = String(currentMonth + 1).padStart(2, '0');
					const formattedDay = String(day).padStart(2, '0');
					const dateStr = `${currentYear}-${formattedMonth}-${formattedDay}`;
					
					// 判定是否為週末 (週日 0, 週六 6)
					const dateObj = new Date(currentYear, currentMonth, day);
					const dayOfWeek = dateObj.getDay();
					const isWeekend = dayOfWeek === 0 || dayOfWeek === 6;
					
					// 預設全月所有時段均可預約
					const defaultStatus = { morning: false, afternoon: false, evening: false, location: "" };
					
					// 合併 JSON 檔案中的自訂覆蓋設定
					const status = {
						...defaultStatus,
						...(bookingData[dateStr] || {})
					};
					
					// 預設 Location 為空 (無指定行程則不顯示地點)
					const displayLocation = status.location || "";
					
					if (displayLocation) {
						// 桌機版地點標籤 (手機端隱藏，桌機端右上角顯現，防範行動版擁擠)
						const locBadge = document.createElement('span');
						const isDefaultLoc = displayLocation === "新竹";
						if (isDefaultLoc) {
							locBadge.className = 'hidden md:block md:absolute md:top-2 md:right-2 text-[10px] text-zinc-500 border px-1 py-0.5 rounded font-light tracking-widest pointer-events-none whitespace-nowrap loc-badge-hsinchu';
						} else {
							locBadge.className = 'hidden md:block md:absolute md:top-2 md:right-2 text-[10px] text-sky-300 bg-sky-500/20 border border-sky-500/30 px-1 py-0.5 rounded font-medium tracking-widest pointer-events-none whitespace-nowrap';
						}
						locBadge.textContent = displayLocation;
						cell.appendChild(locBadge);
					}
					
					// 判定是否有備註註記 (Note)
					let hoverTitle = displayLocation ? `當日地點: ${displayLocation}` : '';
					if (status.note) {
						hoverTitle += ` | 備註: ${status.note}`;
						
						// 在右側放置一個極低調的灰點代表有備忘
						const noteIcon = document.createElement('span');
						noteIcon.className = 'absolute bottom-1 md:bottom-2 right-2 text-[6px] md:text-[7px] text-zinc-600 font-light pointer-events-none';
						noteIcon.textContent = '●';
						cell.appendChild(noteIcon);
					}
					cell.title = hoverTitle;
					
					const slotContainer = document.createElement('div');
					// 永遠為垂直堆疊且橫向撐滿，手機端與桌機端一致
					slotContainer.className = 'flex flex-col gap-0.5 md:gap-1 mt-1 md:mt-2 w-full';

					const slots = [
						{ key: 'morning', text: '早上', label: '上午 AM' },
						{ key: 'afternoon', text: '下午', label: '下午 PM' },
						{ key: 'evening', text: '晚上', label: '晚上 EVE' }
					];

					slots.forEach(slot => {
						const badge = document.createElement('span');
						const isBooked = status[slot.key] === true || status[slot.key] === "客滿" || status[slot.key] === "不開放";
						
						if (isBooked) {
							// 客滿：調暗且 line-through 的小圓角長條
							badge.className = 'w-full text-center text-[7px] md:text-[10.5px] text-zinc-500 bg-zinc-900/60 border border-zinc-800/40 py-0.5 md:py-1 rounded cursor-help line-through opacity-40 md:opacity-50 transition-colors duration-300';
							badge.title = `${slot.label}: 已預約 / 不開放`;
						} else {
							// 有空：帶金色邊框與底色的小圓角長條
							badge.className = 'w-full text-center text-[7px] md:text-[10.5px] text-amber-300 bg-amber-400/10 border border-amber-500/30 py-0.5 md:py-1 rounded cursor-help transition-all duration-300 hover:bg-amber-400/20';
							badge.title = `${slot.label}: 可預約`;
						}
						badge.textContent = slot.text;
						slotContainer.appendChild(badge);
					});

					cell.appendChild(slotContainer);
					calendarDays.appendChild(cell);
				}

				// 方案 B：更新外縣市公告欄
				updateAnnouncements();
			};

			prevBtn?.addEventListener('click', () => {
				currentMonth--;
				if (currentMonth < 0) {
					currentMonth = 11;
					currentYear--;
				}
				render();
			});

			nextBtn?.addEventListener('click', () => {
				currentMonth++;
				if (currentMonth > 11) {
					currentMonth = 0;
					currentYear++;
				}
				render();
			});

			render();
		};

		// 3. 預約表單處理功能
		const initBookingForm = () => {
			const form = document.getElementById('booking-form') as HTMLFormElement;
			const serviceSelect = document.getElementById('form-service') as HTMLSelectElement;
			const requestedService = new URLSearchParams(window.location.search).get('service');
			if (requestedService && Array.from(serviceSelect.options).some((option) => option.value === requestedService)) {
				serviceSelect.value = requestedService;
			}
			const submitBtn = document.getElementById('form-submit-btn');
			const statusMsg = document.getElementById('form-status-msg');
			const successModal = document.getElementById('success-modal');
			const closeSuccessBtn = document.getElementById('close-success-btn');
			const container = document.getElementById('booking-dates-container');
			const addBtn = document.getElementById('add-date-row-btn');
			const turnstileWidget = document.getElementById('turnstile-widget') as HTMLElement | null;
			const turnstileToken = document.getElementById('turnstile-token') as HTMLInputElement | null;
			let turnstileWidgetId: string | undefined;
			if (!form || !submitBtn || !container || !addBtn) return;

			if (turnstileWidget && turnstileToken) {
				let attempts = 0;
				const renderTurnstile = () => {
					const turnstile = (window as any).turnstile;
					if (!turnstile) {
						if (attempts++ < 100) window.setTimeout(renderTurnstile, 50);
						else turnstileWidget.textContent = 'Verification could not be loaded. Please refresh and try again.';
						return;
					}
					if (turnstileWidget.dataset.rendered) return;
					turnstileWidgetId = turnstile.render(turnstileWidget, {
						sitekey: turnstileWidget.dataset.sitekey,
						appearance: 'interaction-only',
						theme: document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark',
						action: 'booking',
						callback: (token: string) => { turnstileToken.value = token; },
						'expired-callback': () => { turnstileToken.value = ''; },
						'error-callback': () => { turnstileToken.value = ''; },
					});
					turnstileWidget.dataset.rendered = 'true';
				};
				renderTurnstile();
			}

			let dateRowCount = 1;

			// 為動態 inputDate 綁定彈出手機原生選擇器防錯
			const bindDatePickerEvents = (row: HTMLElement) => {
				const picker = row.querySelector('.date-picker-input') as HTMLInputElement;
				if (!picker) return;

				const triggerPicker = () => {
					if (typeof picker.showPicker === 'function') {
						try {
							picker.showPicker();
						} catch (e) {
							picker.focus();
						}
					} else {
						picker.focus();
					}
				};

				picker.addEventListener('click', triggerPicker);
				picker.addEventListener('focus', triggerPicker);
			};

			// 初始化第一個日期選擇列
			const firstRow = container.querySelector('.booking-date-row') as HTMLElement;
			if (firstRow) bindDatePickerEvents(firstRow);

			// 新增日期候選列
			addBtn.addEventListener('click', () => {
				const row = document.createElement('div');
				row.className = 'booking-date-row grid grid-cols-1 sm:grid-cols-2 gap-4 p-4 bg-zinc-50 border border-zinc-200 rounded-xl relative shadow-sm animate-fade-in';
				row.innerHTML = `
					<!-- 點選日期 -->
					<div class="flex flex-col gap-2">
						<span class="text-[8px] text-zinc-600 tracking-widest uppercase font-bold">Select Date / 選擇日期</span>
						<input type="date" required aria-label="Preferred date" class="date-picker-input bg-white border border-zinc-200 rounded px-3 py-2 text-xs text-zinc-900 focus:outline-none focus:border-amber-500/60 focus:ring-2 focus:ring-amber-500/10 transition-colors cursor-pointer w-full" />
					</div>
					<!-- 時段多選 -->
					<div class="flex flex-col gap-2">
						<span class="text-[8px] text-zinc-600 tracking-widest uppercase font-bold flex items-center justify-between">
							<span>Preferred Time / 偏好時段 (可複選)</span>
							<button type="button" class="remove-date-row-btn text-red-400 hover:text-red-300 text-[8px] tracking-wider uppercase">✕ Remove</button>
						</span>
						<div class="grid grid-cols-3 gap-2">
							<label class="flex items-center justify-center gap-1.5 py-2 border border-zinc-200 bg-white rounded text-[9px] text-zinc-600 hover:border-amber-500/50 transition-all cursor-pointer select-none has-[:checked]:border-amber-500/60 has-[:checked]:text-amber-800 has-[:checked]:bg-amber-50">
								<input type="checkbox" name="time-slot-${dateRowCount}" value="morning" class="hidden" />
								<span>早上</span>
							</label>
							<label class="flex items-center justify-center gap-1.5 py-2 border border-zinc-200 bg-white rounded text-[9px] text-zinc-600 hover:border-amber-500/50 transition-all cursor-pointer select-none has-[:checked]:border-amber-500/60 has-[:checked]:text-amber-800 has-[:checked]:bg-amber-50">
								<input type="checkbox" name="time-slot-${dateRowCount}" value="afternoon" class="hidden" />
								<span>下午</span>
							</label>
							<label class="flex items-center justify-center gap-1.5 py-2 border border-zinc-200 bg-white rounded text-[9px] text-zinc-600 hover:border-amber-500/50 transition-all cursor-pointer select-none has-[:checked]:border-amber-500/60 has-[:checked]:text-amber-800 has-[:checked]:bg-amber-50">
								<input type="checkbox" name="time-slot-${dateRowCount}" value="evening" class="hidden" />
								<span>晚上</span>
							</label>
						</div>
					</div>
				`;
				
				container.appendChild(row);
				bindDatePickerEvents(row);
				dateRowCount++;

				// 綁定移除按鈕
				const removeBtn = row.querySelector('.remove-date-row-btn');
				removeBtn?.addEventListener('click', () => {
					row.remove();
				});
			});

			// Modal 關閉按鈕
			if (closeSuccessBtn && successModal) {
				closeSuccessBtn.addEventListener('click', () => {
					successModal.classList.remove('opacity-100');
					successModal.querySelector('div')?.classList.add('scale-95');
					setTimeout(() => {
						successModal.classList.add('hidden');
					}, 500);
				});
			}

			// 平滑錨點滾動
			document.querySelectorAll('.booking-scroll-btn').forEach(btn => {
				btn.addEventListener('click', (e) => {
					e.preventDefault();
					const targetId = btn.getAttribute('href');
					if (!targetId) return;
					const targetEl = document.querySelector(targetId);
					if (targetEl) {
						targetEl.scrollIntoView({ behavior: 'smooth' });
					}
				});
			});

			// 提交處理
			form.addEventListener('submit', async (e) => {
				e.preventDefault();
				submitBtn.setAttribute('disabled', 'true');
				
				if (statusMsg) {
					statusMsg.className = 'text-[10px] mt-4 tracking-widest uppercase text-zinc-400 font-medium animate-pulse';
					statusMsg.textContent = 'Sending request / 傳送預約諮詢中...';
					statusMsg.classList.remove('hidden');
				}

				// 彙整表單資料
				const name = (document.getElementById('form-name') as HTMLInputElement).value;
				const line = (document.getElementById('form-line') as HTMLInputElement).value;
				const ig = (document.getElementById('form-ig') as HTMLInputElement).value;
				const phone = (document.getElementById('form-phone') as HTMLInputElement).value;
				const email = (document.getElementById('form-email') as HTMLInputElement).value;
				const service = (document.getElementById('form-service') as HTMLSelectElement).value;
				const message = (document.getElementById('form-message') as HTMLTextAreaElement).value;

				// 彙整日期選擇資料
				const dateRows = container.querySelectorAll('.booking-date-row');
				const preferredDates: Array<{ date: string; slots: string[] }> = [];

				dateRows.forEach(row => {
					const datePicker = row.querySelector('.date-picker-input') as HTMLInputElement;
					if (datePicker && datePicker.value) {
						const selectedSlots: string[] = [];
						const checkBoxes = row.querySelectorAll('input[type="checkbox"]:checked');
						checkBoxes.forEach(cb => {
							const val = (cb as HTMLInputElement).value;
							if (val === 'morning') selectedSlots.push('早上 AM');
							if (val === 'afternoon') selectedSlots.push('下午 PM');
							if (val === 'evening') selectedSlots.push('晚上 EVE');
						});
						preferredDates.push({
							date: datePicker.value,
							slots: selectedSlots
						});
					}
				});

				// 校驗聯絡管道至少填寫一項
				if (!line && !ig && !phone) {
					if (statusMsg) {
						statusMsg.className = 'text-[10px] mt-4 tracking-widest uppercase text-red-500 font-bold';
						statusMsg.textContent = 'Error! LINE, IG, or Phone is required / 請至少留下一個聯絡管道！';
					}
					submitBtn.removeAttribute('disabled');
					return;
				}

				// 校驗理想日期中每個都至少勾選了一個時段
				const isDateSlotsEmpty = preferredDates.some(d => d.slots.length === 0);
				if (isDateSlotsEmpty) {
					if (statusMsg) {
						statusMsg.className = 'text-[10px] mt-4 tracking-widest uppercase text-red-500 font-bold';
						statusMsg.textContent = 'Error! Please select at least one time slot / 請為候選日期勾選時段！';
					}
					submitBtn.removeAttribute('disabled');
					return;
				}

				if (turnstileToken && !turnstileToken.value) {
					if (statusMsg) {
						statusMsg.className = 'text-[10px] mt-4 tracking-widest uppercase text-red-500 font-bold';
						statusMsg.textContent = 'Please complete the security check before sending.';
					}
					submitBtn.removeAttribute('disabled');
					return;
				}

				// 統一交由 Vercel API 驗證資料、阻擋垃圾訊息並寄送通知信。
				const formData = {
					name,
					contact: [line && `LINE: ${line}`, ig && `IG: ${ig}`, phone && `Phone: ${phone}`].filter(Boolean).join(' | '),
					email,
					service,
					date: preferredDates.map(({ date }) => date).join(' | '),
					time: preferredDates.map(({ date, slots }) => `${date} (${slots.join(', ')})`).join(' | '),
					message,
					turnstileToken: turnstileToken?.value || '',
					website: (form.querySelector('[name="website"]') as HTMLInputElement)?.value || ''
				};

				try {
					const response = await fetch('/api/booking', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify(formData)
					});
					const result = await response.json();
					if (!response.ok) throw new Error(result.message || '預約傳送失敗');

					// 提交成功，清空表單
					form.reset();
					
					// 只保留首個日期行
					const rows = container.querySelectorAll('.booking-date-row');
					rows.forEach((row, idx) => {
						if (idx > 0) row.remove();
					});
					const firstPicker = firstRow.querySelector('.date-picker-input') as HTMLInputElement;
					if (firstPicker) firstPicker.value = '';
					firstRow.querySelectorAll('input[type="checkbox"]').forEach(cb => {
						(cb as HTMLInputElement).checked = false;
					});
					turnstileToken && (turnstileToken.value = '');
					if (turnstileWidgetId) (window as any).turnstile?.reset(turnstileWidgetId);

					if (statusMsg) {
						statusMsg.classList.add('hidden');
					}

					// 彈出成功 Modal
					if (successModal) {
						successModal.classList.remove('hidden');
						requestAnimationFrame(() => {
							successModal.classList.add('opacity-100');
							successModal.querySelector('div')?.classList.remove('scale-95');
						});
					}
				} catch (err) {
					console.error("預約提交失敗：", err);
					if (statusMsg) {
						statusMsg.className = 'text-[10px] mt-4 tracking-widest uppercase text-red-500 font-bold';
						statusMsg.textContent = 'Error! Please try again later / 傳送失敗，請稍後再試！';
					}
				} finally {
					submitBtn.removeAttribute('disabled');
				}
			});
		};

		document.addEventListener('astro:page-load', () => {
			initCalendar();
			initBookingForm();
		});
	</script>
</Layout>
