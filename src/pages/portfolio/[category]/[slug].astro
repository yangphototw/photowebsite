---
import Layout from '../../../layouts/Layout.astro';
import fs from 'node:fs';
import path from 'node:path';

// 讀取相簿資料
const albumsPath = path.resolve('src/data/albums.json');
const allAlbums = JSON.parse(fs.readFileSync(albumsPath, 'utf-8'));

export async function getStaticPaths() {
	const albumsPath = path.resolve('src/data/albums.json');
	const allAlbums = JSON.parse(fs.readFileSync(albumsPath, 'utf-8'));
	
	return allAlbums.map((album) => ({
		params: { 
			category: album.categorySlug, 
			slug: album.projectSlug 
		},
		props: { album },
	}));
}

const { album } = Astro.props;

const getThumbSrc = (src: string) => {
	const parts = src.split('/');
	parts.splice(parts.length - 1, 0, 'thumbs');
	return parts.join('/');
};
---

<Layout title={`${album.project} | ${album.category}`}>
	<!-- Project Header: 返回按鈕靠左，內容主體置中 -->
	<header class="py-12 md:py-20 animate-fade-in relative flex flex-col items-center">
		
        <!-- 返回按鈕：絕對定位在左側，不影響主體置中 -->
        <a href={`/${album.categorySlug}`} class="md:absolute left-0 top-1/2 md:-translate-y-1/2 group flex items-center gap-2 text-zinc-600 hover:text-white transition-all duration-500 mb-8 md:mb-0">
            <span class="text-[9px] tracking-[0.4em] uppercase border-b border-zinc-800 group-hover:border-white/40 pb-1">
                ← Back to {album.category}
            </span>
        </a>

        <!-- 單行極小標題：Category - Project (置中) -->
		<h1 class="text-[10px] md:text-[11px] font-light text-zinc-400 tracking-[0.4em] uppercase">
            <span class="text-zinc-600">{album.category}</span>
            <span class="mx-2">—</span>
            <span class="text-white">{album.project}</span>
        </h1>
	</header>

	<!-- Masonry Gallery: 2/3 欄自適應 -->
	<div class="columns-2 sm:columns-3 gap-6 space-y-6 pb-32 animate-fade-in">
		{album.images.map((src) => (
			<div 
				class="break-inside-avoid overflow-hidden rounded-2xl bg-zinc-900 cursor-zoom-in group relative border border-zinc-800/30"
				style="contain: content; will-change: transform;"
			>
				<img
					src={getThumbSrc(src)}
					data-raw={src}
					alt={album.project}
					loading="lazy"
					decoding="async"
					class="w-full h-auto object-cover opacity-80 group-hover:opacity-100 group-hover:scale-[1.02] transition-[transform,opacity] duration-700 ease-out lightbox-trigger"
					style="will-change: transform, opacity;"
				/>
			</div>
		))}
	</div>

	<!-- Lightbox -->
	<div id="lightbox" class="fixed inset-0 bg-black z-[100] hidden opacity-0 transition-opacity duration-500 flex items-center justify-center p-4 md:p-12">
		<div id="lightbox-backdrop" class="absolute inset-0 cursor-zoom-out"></div>
		<img id="lightbox-img" src="" class="relative z-10 max-w-full max-h-full object-contain shadow-2xl scale-95 transition-transform duration-500" />
		<button id="lightbox-close" class="absolute top-8 right-8 z-20 text-zinc-600 hover:text-white text-3xl font-light transition-colors duration-300">
			&times;
		</button>
	</div>

	<style>
		@keyframes fadeIn {
			from { opacity: 0; transform: translateY(15px); }
			to { opacity: 1; transform: translateY(0); }
		}
		.animate-fade-in {
			animation: fadeIn 1.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
		}
	</style>

	<script>
		const setupLightbox = () => {
			const triggers = document.querySelectorAll('.lightbox-trigger');
			const lightbox = document.getElementById('lightbox');
			const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
			const closeBtn = document.getElementById('lightbox-close');
			const backdrop = document.getElementById('lightbox-backdrop');
			if (!lightbox || !lightboxImg) return;
			const open = (src: string, rawSrc?: string) => {
				lightboxImg.src = rawSrc || src;
				lightbox.classList.remove('hidden');
				document.body.style.overflow = 'hidden';
				requestAnimationFrame(() => {
					lightbox.classList.add('opacity-100');
					lightboxImg.classList.remove('scale-95');
				});
			};
			const close = () => {
				lightbox.classList.remove('opacity-100');
				lightboxImg.classList.add('scale-95');
				setTimeout(() => {
					lightbox.classList.add('hidden');
					document.body.style.overflow = '';
				}, 500);
			};
			triggers.forEach(trigger => {
				trigger.addEventListener('click', (e) => {
					const imgEl = e.target as HTMLImageElement;
					const rawSrc = imgEl.getAttribute('data-raw');
					open(imgEl.src, rawSrc || undefined);
				});
			});
			[closeBtn, backdrop].forEach(el => el?.addEventListener('click', close));
			window.addEventListener('keydown', (e) => {
				if (e.key === 'Escape') close();
			});
		};
		document.addEventListener('astro:page-load', setupLightbox);
	</script>
</Layout>
